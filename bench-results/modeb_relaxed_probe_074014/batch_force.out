I'll create a complete, playable Space Invaders in Pygame. Here's the full implementation:

```python
import pygame
import math
import random

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT 600
BACKGROUND = (0, 0)
PLAYER = (0, 255, 0)
ENEMY = (255, 0, 0)
BULLET = (255, 255, 0)
ENEMYELLOW = (255, 0)

# Game
class Space:
    def __init__(self):
        self.x = 400
        self.y = 550
        self.width = 60
        self.height = 40
        self.speed = 5
        self.lives = 0
        self.bullets = []
        self.score = 0

    def move(self, x, y):
        self.x += x * self.speed.y
        self.y += y * self.speed

    def draw(self):
        if self.x == 0:
            self.x = 0
        self.y = 550

    def shoot(self):
        if len(self.bullets) < 5:
            self.bullets.append((self.x + self.y, self.y - 30))

class Enemy:
    def __init__(self, x, y):
        self.x = x
