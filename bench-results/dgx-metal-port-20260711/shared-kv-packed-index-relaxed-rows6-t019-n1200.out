<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Space Invaders - 1978 Taito Arcade</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            overflow: hidden;
        }
        
        .arcade {
            background: #111;
            border: 4px solid #333;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.3), inset 0 0 20px rgba(0, 0, 0, 0.5);
        }
        
        canvas {
            display: block;
            margin: 0 auto;
            background: #000;
            image-rendering: pixelated;
        }
        
        .scoreboard {
            color: #0f0;
            font-size: 24px;
            text-align: center;
            padding: 10px;
            letter-spacing: 4px;
            text-shadow: 0 0 10px #0f0;
        }
        
        .controls {
            color: #555;
            font-size: 12px;
            text-align: center;
            padding: 10px;
        }
        
        .controls span {
            color: #0f0;
        }
        
        @media (max-width: 600px) {
            .arcade {
                padding: 5px;
                border-width: 2px;
            }
            canvas {
                width: 100%;
                height: auto;
            }
        }
    </style>
</head>
