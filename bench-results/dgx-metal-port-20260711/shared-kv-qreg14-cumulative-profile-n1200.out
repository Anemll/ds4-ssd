        const THRUST_ACCELERATION = 300;
        const MAX_SPEED = 300;
        const FRICTION = 0.98;

        // Initialize game
        function initGame() {
            player = {
                x: 400,
                y: 300,
                angle: -Math.PI / 2,
                speed: 0,
                vx: 0,
                vy: 0,
                radius: PLAYER_RADIUS,
                alive: true,
                invulnerable: 0,
                thrust: false
            };
            bullets = [];
            asteroids = [];
            particles = [];
            score = 0;
