                ctx.beginPath();
                ctx.moveTo(0, -10);
                ctx.lineTo(-4, -14);
                ctx.lineTo(4, -14);
                ctx.closePath();
                ctx.fillStyle = '#ff6600';
                ctx.fill();
            }

