<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1978 Taito Arcade - Space Shooter</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
        }
        .arcade {
            background: #111;
            border: 4px solid #333;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 0 40px rgba(0,0,0,0.8), inset 0 0 30px rgba(0,0,0,0.5);
        }
        canvas {
            display: block;
            margin: 0 auto;
            background: #000;
            image-rendering: pixelated;
        }
        .controls {
            color: #ff6600;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            text-shadow: 0 0 10px #ff6600;
        }
        .controls span {
            color: #ffcc00;
        }
    </style>
</head>
<body>
    <div class="arcade">
        <canvas id="gameCanvas" width="400" height="300"></canvas>
        <div class="controls">
