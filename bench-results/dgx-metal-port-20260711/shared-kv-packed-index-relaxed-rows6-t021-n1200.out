            vx: 0, vy: 0,
            angle: -Math.PI/2,
            radius: 8,
            lives: 3,
            invincible: 0
        };
        let bullets = [];
        let asteroids = [];
        let score = 0;
        let gameOver = false;
        let keys = {};

        // Asteroids
        function createAsteroid(x, y, size, vx, vy) {
            return {
                x, y, size, vx, vy,
                radius: size * 4,
                vertices: Math.floor(Math.random() * 8) + 5,
                rotation: Math.random() * Math.PI * 2
            };
        }

        function initAsteroids() {
            asteroids = [];
            for (let i = 0; i < 3; i++) {
                let x, y;
                do {
                    x = Math.random() * W;
                    y = Math.random() * H;
                } while (Math.abs(x - player.x) < 60 && Math.abs(y - player.y) < 60);
                let angle = Math.random() * Math.PI * 2;
                let speed = 0.5 + Math.random() * 1.5;
                asteroids.push(createAsteroid(x, y, 2, Math.cos(angle)*speed, Math.sin(angle)*speed));
            }
        }

