            ctx.beginPath();
            ctx.moveTo(12, 0);
            ctx.lineTo(-8, 8);
            ctx.lineTo(-6, -8);
            ctx.closePath();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Invincibility flash
            if (player.invincible > 0) {
                ctx.strokeStyle = '#ff00ff';
                ctx.stroke();
            }
            ctx.restore();
        }

