<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1978 Taito Arcade - Aster</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
        }
        .cabinet-wrapper {
            background: #2a1a0a;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 0 40px rgba(255, 100, 0, 0.3), inset 0 0 30px rgba(0,0,0,0.8);
            border: 3px solid #5a3a1a;
        }
        .game-container {
            position: relative;
            background: #111;
            padding: 10px;
            border-radius: 10px;
            border: 2px solid #f0a030;
        }
        canvas {
            display: block;
            margin: 0 auto;
            background: #000;
            image-rendering: pixelated;
            border: 2px solid #f0a030;
            box-shadow: inset 0 0 20px rgba(255, 160, 0, 0.2);
        }
        .info {
            color: #f0a030;
            text-align: center;
            padding: 8px 0;
            font-size: 14px;
            letter-spacing: 2px;
            text-shadow: 0 0 5px #f0a030;
        }
        .controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 10px 0;
            color: #f0a030;
            font-size: 12px;
        }
        .controls span {
            background: #2a1a0a;
            padding: 4px 12px;
            border-radius: 4px;
            border: 1px solid #f0a030;
        }
        .btn {
            background: #f0a030;
            color: #000;
            border: none;
            padding: 6px 16px;
            border-radius: 4px;
            font-family: inherit;
            font-weight: bold;
            cursor: pointer;
            margin: 4px;
        }
        .btn:hover {
            background: #ffb840;
        }
    </style>
</head>
