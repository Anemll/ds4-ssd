Here's a complete Space Invaders game in Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self):
        self.width = 60
        self.height = 20
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        # Draw triangle on top
        pygame.draw.polygon(screen, GREEN, 
                           [(self.x + self.width//2, self.y - 10),
                            (self.x, self.y),
                            (self.x + self.width, self.y)])

class Invader:
    def __init__(self, x, y, speed):
        self.width = 40
        self.height = 30
        self.x = x
        self.y = y
        self.speed = speed
        self.direction = 1  # 1 for right, -1 for left
        
    def update(self):
        self.x += self.speed * self.direction
        
        # Change direction at edges
        if self.x <= 0 or self.x >= SCREEN_WIDTH - self.width:
            self.direction *= -1
            self.y += 20  # Move down
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        # Draw alien features
        for i in range(3):
            pygame.draw.circle(screen, BLACK, 
                              (self.x + 10 + i * 15, self.y + 10), 3)

class Bullet:
    def __init__(self, x, y, speed, is_enemy=False):
        self.x = x
        self.y = y
        self.speed = speed
        self.is_enemy = is_enemy
        self.width = 4
        self.height = 10
        
    def update(self):
        self.y += self.speed
        
    def draw(self, screen):
        if self.is_enemy:
            pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        else:
            pygame.draw.rect(screen, YELLOW, (self.x, self.y, self.width, self.height))

class SpaceInvaders:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock = pygame.time.Clock()
        self.running = True
        self.font = pygame.font.Font(None, 36)
        
        # Game objects
        self.player = Player()
        self.invaders = []
        self.bullets = []
        self.enemy_bullets = []
        
        # Initialize invaders
        self.create_invaders()
        
    def create_invaders(self):
        # Create grid of invaders
        for row in range(5):
            for col in range(10):
                x = col * 70 + 50
                y = row * 50 + 50
                speed = random.randint(1, 3)
                self.invaders.append(Invader(x, y, speed))
    
    def shoot(self):
        if self.player.y > 0:
            bullet = Bullet(self.player.x + self.player.width // 2 - 2, 
                           self.player.y - 10, -10, False)
            self.bullets.append(bullet)
    
    def enemy_shoot(self):
        if random.random() < 0.05:  # 5% chance of shooting
            if self.invaders:
                invader = random.choice(self.invaders)
                bullet = Bul
