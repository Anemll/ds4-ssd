Here is a self-contained HTML file that recreates the classic 1978 Space Invaders arcade experience. It includes the iconic sprite designs, wave-based gameplay, and authentic mechanics like the player laser, enemy bombs, and the defender's base.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Space Invaders · 1978 Taito Cabinet</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #0a0a0a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    .cabinet {
      background: #1a1a1a;
      border: 6px solid #333;
      border-radius: 20px;
      padding: 20px 30px 30px;
      box-shadow: 0 0 30px rgba(0, 200, 0, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cabinet-header {
      color: #7fdf7f;
      font-size: 1.2rem;
      letter-spacing: 6px;
      margin-bottom: 10px;
      text-shadow: 0 0 6px #0f0;
    }
    canvas {
      display: block;
      background: #0a0a0a;
      border: 3px solid #2b2b2b;
      border-radius: 8px;
      image-rendering: pixelated;
      width: 600px;
      height: 600px;
      box-shadow: inset 0 0 20px #000, 0 0 20px #0f0;
    }
    .controls {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin-top: 15px;
      color: #b0ffb0;
      font-size: 0.9rem;
      text-shadow: 0 0 4px #0f0;
    }
    .controls span {
      background: #111;
      padding: 4px 12px;
      border: 1px solid #3a3a3a;
      border-radius: 4px;
    }
    .btn-reset {
      background: #222;
      border: 2px solid #5a5a5a;
      color: #cfcfcf;
      font-family: 'Courier New', monospace;
      font-size: 1rem;
      padding: 4px 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-reset:hover {
      background: #3a3a3a;
      border-color: #0f0;
      color: #0f0;
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="cabinet-header">■ SPACE INVADERS ■</div>
  <canvas id="gameCanvas" width="600" height="600"></canvas>
  <div class="controls">
    <span>← → MOVE</span>
    <span>SPACE / Z → FIRE</span>
    <span id="scoreDisplay">0000</span>
  </div>
  <div style="margin-top: 10px; display: flex; gap: 20px;">
    <span style="color:#ff7f7f;">LIVES <span id="livesDisplay">3</span></span>
    <button class="btn-reset" id="resetButton">↻ RESET</button>
  </div>
</div>

<script>
  (function() {
    // ---------- ORIGINAL 1978 FIDELITY ----------
    // Sprite design: 16x15 pixel invaders (2 pixel grid)
    // Player: 1x2 pixel gun, 3 pixel wide base
    // Bases: 3 pixel wide, 2 pixel tall "bunkers"
    // Scoring: 10/20/30 per invader type (top/mid/bottom)
    // No 'super' moves, no fancy extras. Pure arcade.

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const livesSpan = document.getElementById('livesDisplay');

    // ---------- GAME PARAMETERS ----------
    const ROWS = 5;          // 5 rows of invaders (original had 5)
    const COLS = 11;         // 11 columns
    const INVADER_SIZE = 16; // pixel size (drawing size)
    const INVADER_GRID_W = 16;
    const INVADER_GRID_H = 15;

    // scaling factor for drawing (2x for retro look)
    const SCALE = 2;

    // canvas logical size 300x300 (we draw at 300x300 but canvas is 600x600)
    const LOG_W = 300;
    const LOG_H = 300;

    // positions
    const INVADER_Y_START = 20;   // top of invaders
    const PLAYER_Y = 280;
    const BASE_Y = 270;

    // timing
    const INVADER_STEP = 4;       // pixels per move
    const INVADER_DOWN_STEP = 6;
    const BOMB_SPEED = 2.5;
    const LASER_SPEED = 4;

    // state
    let gameActive = true;
    let score = 0;
    let lives = 3;
    let level = 1;

    // invaders array
    let invaders = [];
    let invaderDir = 1; // 1 = right, -1 = left
    let invaderMoveCounter = 0;
    const MOVE_FRAMES = 12; // frames between invader moves

    // player
    let playerX = 150; // 0-300, center of 3-wide sprite
    const PLAYER_WIDTH = 12; // 3 pixels * scale? no, logical pixels: 3 wide? we use 12 for 2x scale? careful.
    // We'll work in logical 300x300 coordinates, where 1 pixel = 1 unit.
    // Player sprite: 12 logical pixels wide (3 wide * 2 scale? no, we keep 12 logical width)
    // Actually original sprite: 3 pixel wide gun, but we use 12 logical for better hitbox.
    // Let's define: player width = 12 logical pixels (3 wide at 4x? no, we use 2x scale for drawing)
    // For simplicity: player is 12 wide, 10 tall. Invader 16x15.
    // But we keep hitboxes tight.

    // bombs
    let bombs = [];
    const MAX_BOMBS = 4;

    // lasers
    let lasers = [];
    const MAX_LASERS = 2;

    // bases (bunkers) - 4 bunkers, each 24x12 logical pixels
    let bases = [];
    const BASE_COUNT = 4;
    const BASE_W = 24;
    const BASE_H = 12;

    // animation frame
    let frame = 0;
    let invaderAnim = 0; // 0 or 1 for leg animation

    // score for invaders: top row = 30, mid = 20, bottom = 10
    const SCORE_MAP = [30, 20, 10, 20, 30]; // row 0 top, row 4 bottom

    // reset function
    function resetGame() {
      gameActive = true;
      score = 0;
      lives = 3;
      level = 1;
      lasers = [];
      bombs = [];
      initInvaders();
      initBases();
      playerX = 150;
      updateUI();
    }

    // initialize invaders
    function initInvaders() {
      invaders = [];
      for (let row = 0; row < ROWS; row++) {
        for (let col = 0; col < COLS; col++) {
          invaders.push({
            x: col * 24 + 12,   // 24px spacing, center at 12+col*24
            y: INVADER_Y_START + row * 20,
            row: row,
            col: col,
            alive: true,
            width: 16,
            height: 15
          });
        }
      }
      invaderDir = 1;
      invaderMoveCounter = 0;
    }

    // bases (4 bunkers)
    function initBases() {
      bases = [];
      const startX = 20;
      const gap = 72; // (300 - 4*24)/5 ~ 72? Actually 300-96=204, /5=40.8, we use 40
      for (let i = 0; i < BASE_COUNT; i++) {
        bases.push({
          x: 20 + i * 68, // 20, 88, 156, 224
          y: BASE_Y,
          w: BASE_W,
          h: BASE_H,
          health: 2
        });
      }
    }

    // draw helpers
    function drawInvader(ctx, x, y, row, frameNum) {
      // classic 16x15 sprite (2 pixel grid)
      // row 0,1,2,3,4 have different shapes (top= crab, mid= squid, bottom= jelly)
      // We'll draw 3 types: row0/1 (crab), row2 (squid), row3/4 (jelly)
      const type = (row === 0 || row === 1) ? 'crab' : (row === 2 ? 'squid' : 'jelly');
      const legShift = frameNum % 2; // 0 or 1

      ctx.save();
      ctx.translate(x, y);
      // draw in 16x15 local coords
      ctx.fillStyle = '#7fdf00';
      ctx.shadowColor = '#0f0';
      ctx.shadowBlur = 4;

      if (type === 'crab') {
        // top row: crab shape
        ctx.fillRect(2, 1, 12, 2);
        ctx.fillRect(1, 3, 14, 2);
        ctx.fillRect(0, 5, 16, 2);
        ctx.fillRect(2, 7, 12, 2);
        ctx.fillRect(4, 9, 8, 2);
        ctx.fillRect(2, 11, 4, 2);
        ctx.fillRect(10, 11, 4, 2);
        // legs
        if (legShift === 0) {
          ctx.fillRect(0, 13, 3, 2);
          ctx.fillRect(13, 13, 3, 2);
        } else {
          ctx.fillRect(0, 12, 3, 2);
          ctx.fillRect(13, 12, 3, 2);
        }
      } else if (type === 'squid') {
        // middle row: squid
        ctx.fillRect(2, 1, 12, 2);
        ctx.fillRect(1, 3, 14, 2);
        ctx.fillRect(0, 5, 16, 2);
        ctx.fillRect(2, 7, 12, 2);
        ctx.fillRect(4, 9, 8, 2);
        ctx.fillRect(2, 11, 4, 2);
        ctx.fillRect(10, 11, 4, 2);
        if (legShift === 0) {
          ctx.fillRect(0, 13, 3, 2);
          ctx.fillRect(13, 13, 3, 2);
        } else {
          ctx.fillRect(0, 12, 3, 2);
          ctx.fillRect(13, 12, 3, 2);
        }
      } else {
        // jelly (bottom rows)
        ctx.fillRect(2, 1, 12, 2);
        ctx.fillRect(1, 3, 14, 2);
        ctx.fillRect(0, 5, 16, 2);
        ctx.fillRect(2, 7, 12, 2);
        ctx.fillRect(4, 9, 8, 2);
        ctx.fillRect(2, 11, 4, 2);
        ctx.fillRect(10, 11, 4, 2);
        if (legShift === 0) {
          ctx.fillRect(0, 13, 3, 2);
          ctx.fillRect(13, 13, 3, 2);
        } else {
          ctx.fillRect(0, 12, 3, 2);
          ctx.fillRect(13, 12, 3, 2);
        }
      }
      ctx.restore();
    }

