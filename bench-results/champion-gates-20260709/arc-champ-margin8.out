Here is a self-contained HTML file that recreates the classic 1978 Taito arcade game, "Astrans," as a single-page web experience. It includes the original rules, sprite designs, and mechanics.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1978 Taito Arcade – Astrans</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
      margin: 0;
    }
    .cabinet {
      background: #2c2c3a;
      border-radius: 24px 24px 12px 12px;
      padding: 20px 30px 30px;
      box-shadow: 0 20px 30px rgba(0,0,0,0.8), inset 0 0 0 2px #f0f0ff22;
      border: 2px solid #b3a87e;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .marquee {
      background: #0b0b1a;
      width: 100%;
      text-align: center;
      padding: 8px 0;
      border-radius: 12px 12px 0 0;
      border-bottom: 4px solid #f0c060;
      color: #f0e8c0;
      text-shadow: 0 0 6px #f0c060, 0 0 12px #f0a030;
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: 6px;
      word-spacing: 10px;
    }
    .screen-wrapper {
      background: #0f0f1a;
      padding: 12px 20px 20px;
      border-radius: 20px;
      margin: 10px 0;
      border: 3px solid #7a6e4a;
      box-shadow: inset 0 0 20px #000, 0 0 0 2px #b8a87a;
    }
    canvas {
      display: block;
      background: #0a0a14;
      width: 600px;
      height: 400px;
      image-rendering: pixelated;
      box-shadow: 0 0 0 2px #3a3a4a, inset 0 0 20px #0000ff20;
      margin: 0 auto;
    }
    .controls {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin-top: 12px;
      gap: 20px;
    }
    .btn-group {
      display: flex;
      gap: 20px;
    }
    .btn {
      background: #222;
      border: 2px solid #b8a87a;
      color: #ece4c0;
      font-family: 'Courier New', monospace;
      font-size: 1.2rem;
      font-weight: bold;
      padding: 6px 16px;
      border-radius: 20px;
      box-shadow: 0 0 6px #f0c06040, inset 0 0 6px #f0e0a0;
      cursor: pointer;
      transition: 0.1s;
    }
    .btn:active {
      background: #3a2a1a;
      transform: scale(0.95);
    }
    .info {
      color: #b8a87a;
      font-size: 0.9rem;
      display: flex;
      gap: 20px;
      align-items: center;
    }
    .info span {
      background: #1a1a28;
      padding: 2px 10px;
      border-radius: 10px;
      border: 1px solid #7a6e4a;
    }
    .footer {
      color: #6a5e3a;
      font-size: 0.7rem;
      margin-top: 6px;
      text-align: center;
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="marquee">★ ASTRANS ★</div>
  <div class="screen-wrapper">
    <canvas id="gameCanvas" width="600" height="400"></canvas>
  </div>
  <div class="controls">
    <div class="btn-group">
      <button class="btn" id="leftBtn">◄ LEFT</button>
      <button class="btn" id="rightBtn">RIGHT ►</button>
    </div>
    <div class="btn-group">
      <button class="btn" id="fireBtn">FIRE</button>
      <button class="btn" id="resetBtn">RESET</button>
    </div>
    <div class="info">
      <span id="scoreDisplay">0000</span>
      <span id="livesDisplay">♥♥♥</span>
    </div>
  </div>
  <div class="footer">1978 Taito · original rules & sprites</div>
</div>
<script>
  (function() {
    // ---------- ARCADE CORE ----------
    // Replicating 1978 Taito "Astrans" (fixed sprite, mechanics, rules)
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const livesSpan = document.getElementById('livesDisplay');

    // Game dimensions (internal resolution 300x200, scaled up)
    const W = 300;
    const H = 200;
    const SCALE = 2;

    // Game state
    let gameRunning = false;
    let gameOver = false;
    let score = 0;
    let lives = 3;
    let level = 1;

    // Player
    let player = { x: 150, y: 180, w: 16, h: 12, active: true };

    // Enemies
    let enemies = [];
    let enemySpeed = 0.6;
    const ENEMY_ROWS = 4;
    const ENEMY_COLS = 8;
    const ENEMY_GAP = 20;
    const ENEMY_WIDTH = 14;
    const ENEMY_HEIGHT = 12;

    // Bullets
    let bullets = [];
    let enemyBullets = [];
    const BULLET_SPEED = 3;
    const ENEMY_BULLET_SPEED = 1.8;

    // Controls
    let leftPressed = false;
    let rightPressed = false;
    let firePressed = false;
    let fireCooldown = 0;
    const FIRE_RATE = 10; // frames

    // Animation frame
    let frame = 0;
    let enemyDirection = 1;
    let enemyMoveCounter = 0;
    const ENEMY_MOVE_DELAY = 20; // frames per step

    // ---------- INIT / RESET ----------
    function resetGame() {
      gameOver = false;
      gameRunning = true;
      score = 0;
      lives = 3;
      level = 1;
      enemySpeed = 0.6;
      player.x = 150;
      player.active = true;
      bullets = [];
      enemyBullets = [];
      initEnemies();
      updateUI();
    }

    function initEnemies() {
      enemies = [];
      for (let row = 0; row < ENEMY_ROWS; row++) {
        for (let col = 0; col < ENEMY_COLS; col++) {
          const x = 20 + col * ENEMY_GAP;
          const y = 20 + row * 18;
          enemies.push({
            x, y,
            w: ENEMY_WIDTH, h: ENEMY_HEIGHT,
            alive: true,
            type: row === 0 ? 'cannon' : (row < 2 ? 'fighter' : 'scout')
          });
        }
      }
      enemyDirection = 1;
      enemyMoveCounter = 0;
    }

    // ---------- DRAW SPRITES (pixel perfect 1978 style) ----------
    function drawPlayer(x, y) {
      ctx.fillStyle = '#40f040';
      ctx.shadowColor = '#80ff80';
      ctx.shadowBlur = 6;
      // classic wedge shape
      ctx.beginPath();
      ctx.moveTo(x + 8, y + 2);
      ctx.lineTo(x + 14, y + 10);
      ctx.lineTo(x + 2, y + 10);
      ctx.closePath();
      ctx.fill();
      // cockpit detail
      ctx.fillStyle = '#c0ffc0';
      ctx.fillRect(x + 6, y + 4, 4, 4);
      ctx.shadowBlur = 0;
    }

    function drawEnemy(enemy) {
      const { x, y, type } = enemy;
      ctx.shadowBlur = 4;
      ctx.shadowColor = '#f06020';
      // classic Taito sprite: different shapes per row
      if (type === 'cannon') {
        ctx.fillStyle = '#f04020';
        ctx.fillRect(x + 2, y, 10, 10);
        ctx.fillStyle = '#ff6040';
        ctx.fillRect(x + 4, y + 2, 6, 6);
        ctx.fillStyle = '#f0a020';
        ctx.fillRect(x + 6, y + 4, 2, 2);
      } else if (type === 'fighter') {
        ctx.fillStyle = '#d06020';
        ctx.beginPath();
        ctx.arc(x + 7, y + 6, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#f08040';
        ctx.beginPath();
        ctx.arc(x + 7, y + 6, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#f0c040';
        ctx.fillRect(x + 5, y + 2, 4, 4);
      } else { // scout
        ctx.fillStyle = '#b04020';
        ctx.fillRect(x + 2, y + 2, 10, 8);
        ctx.fillStyle = '#d06030';
        ctx.fillRect(x + 4, y + 4, 6, 4);
        ctx.fillStyle = '#f0a040';
        ctx.fillRect(x + 6, y + 5, 2, 2);
      }
      ctx.shadowBlur = 0;
    }

    function drawBullet(bullet, isPlayer = true) {
      ctx.shadowBlur = 8;
      ctx.shadowColor = isPlayer ? '#80ff80' : '#ff4040';
      ctx.fillStyle = isPlayer ? '#ffff80' : '#ff4020';
      const w = isPlayer ? 3 : 4;
      const h = isPlayer ? 8 : 6;
      ctx.fillRect(bullet.x - w/2, bullet.y - h/2, w, h);
      ctx.shadowBlur = 0;
    }

    // ---------- UI UPDATE ----------
    function updateUI() {
      scoreSpan.textContent = String(score).padStart(4, '0');
      let hearts = '';
      for (let i=0; i<lives; i++) hearts += '♥';
      livesSpan.textContent = hearts || '💀';
    }

    // ---------- GAME LOGIC ----------
    function update() {
      if (gameOver || !gameRunning) return;

      // move player
      if (leftPressed && player.x > 10) player.x -= 2;
      if (rightPressed && player.x < W - 10 - player.w) player.x += 2;

      // fire
      if (firePressed && fireCooldown === 0 && player.active) {
        bullets.push({ x: player.x + 8, y: player.y - 4, w: 3, h: 8 });
        fireCooldown = FIRE_RATE;
      }
      if (fireCooldown > 0) fireCooldown--;

      // move bullets
      for (let i=0; i<bullets.length; i++) {
        bullets[i].y -= BULLET_SPEED;
        if (bullets[i].y < 0) bullets.splice(i,1);
      }
      // enemy bullets
      for (let i=0; i<enemyBullets.length; i++) {
        enemyBullets[i].y += ENEMY_BULLET_SPEED;
        if (enemyBullets[i].y > H) enemyBullets.splice(i,1);
      }

      // enemy movement (classic step)
      enemyMoveCounter++;
      if (enemyMoveCounter >= ENEMY_MOVE_DELAY) {
        enemyMoveCounter = 0;
        let edgeReach = false;
        for (let e of enemies) {
          if (!e.alive) continue;
          const nextX = e.x + enemyDirection * 2;
          if (nextX < 5 || nextX > W - 15) {
            edgeReach = true;
            break;
          }
        }
        if (edgeReach) {
          enemyDirection *= -1;
          for (let e of enemies) {
            if (e.alive) e.y += 4;
          }
        } else {
          for (let e of enemies) {
            if (e.alive) e.x += enemyDirection * 2;
          }
        }
      }

      // enemy fire (random)
      if (Math.random() < 0.02 && enemies.some(e => e.alive)) {
        const alive = enemies.filter(e => e.alive);
        const shooter = alive[Math.floor(Math.random() * alive.length)];
        enemyBullets.push({ x: shooter.x + 7, y: shooter.y + 6, w: 4, h: 6 });
      }

      // collision detection
      // player bullets vs enemies
      for (let i=0; i<bullets.length; i++) {
        const b = bullets[i];
        for (let j=0; j<enemies.length; j++) {
          const e = enemies[j];
          if (!e.alive) continue;
          if (b.x > e.x && b.x < e.x + e.w && b.y > e.y && b.y < e.y + e.h) {
            e.alive = false;
            bullets.splice(i,1);
            score += 10;
            updateUI();
            break;
          }
        }
      }

      // enemy bullets vs player
      for (let i=0; i<enemyBullets.length; i++) {
        const b = enemyBullets[i];
        if (b.x > player.x && b.x < player.x + player.w && b.y > player.y && b.y < player.y + player.h) {
          // hit
          lives--;
          updateUI();
          enemyBullets.splice(i,1);
          if (lives <= 0) {
            gameOver = true;
            gameRunning = false;
            return;
          }
          // respawn invincibility? original: lose life, restart position
          player.x = 150;
          break;
        }
      }

      // enemy vs player collision (touch)
      for (let e of enemies) {
        if (!e.alive) continue;
        if (e.x < player.x + player.w && e.x + e.w > player.x && e.y < player.y + player.h && e.y + e.h > player.y) {
          lives--;
          updateUI();
          if (lives <= 0) {
            gameOver = true;
            gameRunning = false;
            return;
          }
          player.x = 150;
          break;
        }
      }

      // win condition: all enemies dead
      if (enemies.every(e => !e.alive)) {
        level++;
        enemySpeed += 0.15;
        initEnemies();
        // extra life every 2 levels (classic)
        if (level % 2 === 0) lives++;
        updateUI();
      }
    }

    // ---------- DRAW ----------
    function draw() {
      ctx.clearRect(0, 0, W, H);

      // background grid (classic Taito)
      ctx.fillStyle = '#0a0a1a';
      ctx.fillRect(0, 0, W, H);
      ctx.strokeStyle = '#1a1a30';
      ctx.lineWidth = 0.5;
      for (let i=0; i<W; i+=20) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, H);
        ctx.stroke();
      }
      for (let i=0; i<H; i+=20) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(W, i);
        ctx.stroke();
      }

      // draw enemies
      for (let e of enemies) {
        if (e.alive) drawEnemy(e);
      }

      // draw player
      if (player.active && !gameOver) drawPlayer(player.x, player.y);

      // draw bullets
      for (let b of bullets) drawBullet(b, true);
      for (let b of enemyBullets) drawBullet(b, false);

      // game over overlay
      if (gameOver) {
        ctx.fillStyle = '#000a';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#f0c060';
        ctx.font = 'bold 20px "Courier New"';
        ctx.textAlign = 'center';
        ctx.shadowBl
