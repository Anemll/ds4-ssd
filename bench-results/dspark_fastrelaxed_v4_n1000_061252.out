Here's a complete Space Invaders game using Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
YELLOW = (255, 255, 0)

# Set up the display
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Space Invaders")
clock = pygame.time.Clock()

class Player:
    def __init__(self):
        self.width = 50
        self.height = 30
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
            
    def draw(self):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        # Draw a triangle on top
        pygame.draw.line(screen, GREEN, 
                (self.x + self.width//2, self.y - 10),
                (self.x, self.y), 2)
        pygame.draw.line(screen, GREEN,
                (self.x + self.width//2, self.y - 10),
                (self.x + self.width, self.y), 2)
        
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

class Alien:
    def __init__(self, x, y):
        self.width = 40
        self.height = 20
        self.x = x
        self.y = y
        self.speed = 2
        self.direction = 1  # 1 for right, -1 for left
        
        self.animation_frame = 0
        self.animation_cycle = 0
        
    def update(self):
        self.x += self.speed * self.direction
        self.animation_cycle += 1
        if self.animation_cycle >= 10:
            self.animation_frame = (self.animation_frame + 1) % 2
            self.animation_cycle = 0
            
    def draw(self):
        # Draw a simple alien
        color = RED
        if self.animation_frame == 0:
            pygame.draw.rect(screen, (255, 100, 100), (self.x, self.y, self.width, self.height))
        else:
            pygame.draw.rect(screen, color, (self.x + 2, self.y + 2, self.width - 4, self.height - 4))
        
        # Eyes
        eye_size = 5
        pygame.draw.circle(screen, WHITE, 
                (self.x + self.width//3, self.y + self.height//3), eye_size)
        pygame.draw.circle(screen, WHITE,
                (self.x + 2*self.width//3, self.y + self.height//3), eye_size)
        pygame.draw.circle(screen, BLACK,
                (self.x + self.width//3, self.y + self.height//3), 2)
        pygame.draw.circle(screen, BLACK,
                (self.x + 2*self.width//3, self.y + self.height//3), 2)
        
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

class Bullet:
    def __init__(self, x, y, speed=10):
        self.x = x
        self.y = y
        self.speed = speed
        self.width = 4
        self.height = 10
        
    def update(self):
        if self.y > 0:
            self.y += self.speed
        
    def draw(self):
        pygame.draw.rect(screen, YELLOW, (self.x - self.width//2, self.y, self.width, self.height))
        
    def get_rect(self):
        return pygame.Rect(self.x - self.width//2, self.y, self.width, self.height)

