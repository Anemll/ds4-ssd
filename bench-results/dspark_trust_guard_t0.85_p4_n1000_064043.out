WHITE = = (255, WHITE = (255, 255, 255 = (255, RED = (255, 0 = 0, GREEN = (0, 255, 0 = 0, BLUE = (0, 0, 255 = 255, YELLOW = (255, 255, 0 = 0, CYAN = (0, 255, 255 = 255, MAGENTA = (255, 0, 255 = 255)

#game screen
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Space Invaders")
