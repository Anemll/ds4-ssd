Here is a self-contained HTML file that recreates the classic 1978 Taito Space Invaders arcade experience. It includes the original rules, sprite designs, and mechanics.
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPACE INVADERS · 1978 Taito</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #111;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
        }
        .cabinet {
            background: #222;
            border: 6px solid #543;
            border-radius: 20px 20px 12px 12px;
            padding: 20px 25px 25px 25px;
            box-shadow: 0 0 30px rgba(0,0,0,0.8), inset 0 0 10px #3a2a1a;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .screen-wrapper {
            background: #0a0a0a;
            border: 6px solid #333;
            border-radius: 10px;
            padding: 10px;
            box-shadow: inset 0 0 20px #000, 0 0 0 2px #2b1a0e;
        }
        canvas {
            display: block;
            background: #000;
            width: 600px;
            height: 600px;
            image-rendering: pixelated;
            box-shadow: 0 0 0 2px #0f0f0f;
        }
        .controls {
            display: flex;
            justify-content: space-between;
            width: 100%;
            margin-top: 20px;
            gap: 20px;
            color: #aaa;
            font-weight: bold;
            text-shadow: 0 0 4px #000;
        }
        .btn-group {
            display: flex;
            gap: 20px;
        }
        .btn {
            background: #2b1a0e;
            border: 3px solid #543;
            border-radius: 12px;
            padding: 10px 20px;
            color: #ddd;
            font-family: 'Courier New', monospace;
            font-size: 1.4rem;
            font-weight: bold;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 4px 0 #1a0e06;
            transition: 0.05s linear;
        }
        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 #1a0e06;
        }
        .info {
            display: flex;
            gap: 30px;
            font-size: 1.2rem;
            background: #1a1a1a;
            padding: 6px 20px;
            border-radius: 20px;
            border: 2px solid #3a2a1a;
        }
        .info span {
            color: #fafafa;
            background: #000;
            padding: 0 10px;
            border-radius: 6px;
        }
        .footer {
            margin-top: 10px;
            color: #666;
            font-size: 0.9rem;
            letter-spacing: 2px;
        }
        @media (max-width: 700px) {
            canvas { width: 360px; height: 360px; }
            .controls { flex-direction: column; align-items: center; }
        }
    </style>
</head>
<body>
<div class="cabinet">
    <div class="screen-wrapper">
        <canvas id="gameCanvas" width="600" height="600"></canvas>
    </div>
    <div class="controls">
        <div class="btn-group">
            <button class="btn" id="leftBtn">◄ LEFT</button>
            <button class="btn" id="rightBtn">RIGHT ►</button>
        </div>
        <div class="info">
            <span>👾 <span id="scoreDisplay">000</span></span>
            <span>❤️ <span id="livesDisplay">3</span></span>
        </div>
        <button class="btn" id="fireBtn">🔥 FIRE</button>
    </div>
    <div class="footer">Ⓡ 1978 TAIKO · SPACE INVADERS · ARCADE</div>
</div>

<script>
    (function() {
        // ========== 1978 ORIGINAL FIDELITY ==========
        // Sprite definitions (pixel art, 16x16)
        const INVADER_SPRITE = [
            "  ******  ",
            " * *  * * ",
            "  **  **  ",
            "   ****   ",
            "  * ** *  ",
            " *  **  * ",
            "  ******  ",
            "  *    *  "
        ];
        // Alternate frame (squid/ crab)
        const INVADER_SPRITE2 = [
            "  ******  ",
            " *  **  * ",
            "  **  **  ",
            "   ****   ",
            "  * ** *  ",
            " *  **  * ",
            "  ******  ",
            "  *    *  "
        ];
        // Player sprite (base + cannon)
        const PLAYER_SPRITE = [
            "    **    ",
            "   ****   ",
            "   ****   ",
            "  **  **  ",
            "  **  **  ",
            " ******** ",
            " ******** ",
            "  **  **  "
        ];
        // Explosion (simple)
        const EXPLOSION = [
            "    **    ",
            "   *  *   ",
            "  * ** *  ",
            " ** ** ** ",
            " ** ** ** ",
            "  * ** *  ",
            "   *  *   ",
            "    **    "
        ];

        // ---------- CANVAS ----------
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreSpan = document.getElementById('scoreDisplay');
        const livesSpan = document.getElementById('livesDisplay');

        // ---------- GAME STATE ----------
        let gameRunning = false;
        let score = 0;
        let lives = 3;
        let level = 1;
        let frame = 0;

        // invaders
        let invaders = [];
        let invaderDirection = 1; // 1 = right, -1 = left
        let invaderStep = 0;
        let invaderAnim = 0; // 0 or 1
        let moveCounter = 0;
        const INVADER_ROWS = 5;
        const INVADER_COLS = 11;
        const INVADER_SIZE = 16; // pixels (drawn scaled)
        const INVADER_SCALE = 2.5;

        // player
        let playerX = 300 - 20; // center (approx)
        const PLAYER_Y = 540;
        const PLAYER_WIDTH = 28;
        const PLAYER_HEIGHT = 20;

        // bullets
        let playerBullet = null; // {x, y, active}
        let invaderBullets = [];
        const BULLET_SPEED = 6;
        const INVADER_BULLET_SPEED = 4;

        // explosions
        let explosions = [];

        // timing
        let invaderMoveTimer = 0;
        const INVADER_MOVE_DELAY = 10; // frames
        let invaderShootTimer = 0;
        const INVADER_SHOOT_DELAY = 25; // frames

        // input
        let leftPressed = false;
        let rightPressed = false;
        let firePressed = false;

        // ---------- INIT / RESET ----------
        function resetGame() {
            score = 0;
            lives = 3;
            level = 1;
            gameRunning = true;
            initLevel();
            updateUI();
        }

        function initLevel() {
            invaders = [];
            invaderDirection = 1;
            invaderStep = 0;
            moveCounter = 0;
            invaderAnim = 0;
            playerBullet = null;
            invaderBullets = [];
            explosions = [];

            const startX = 60;
            const startY = 40;
            for (let row = 0; row < INVADER_ROWS; row++) {
                for (let col = 0; col < INVADER_COLS; col++) {
                    invaders.push({
                        x: startX + col * 28,
                        y: startY + row * 24,
                        alive: true,
                        row: row,
                        col: col
                    });
                }
            }
            // player position
            playerX = 300 - 14;
        }

        // ---------- DRAW SPRITES (pixel accurate) ----------
        function drawSprite(spriteArray, x, y, scale = INVADER_SCALE, flip = false) {
            const rows = spriteArray.length;
            const cols = spriteArray[0].length;
            for (let i = 0; i < rows; i++) {
                for (let j = 0; j < cols; j++) {
                    const ch = spriteArray[i][j];
                    if (ch === '*') {
                        const px = flip ? (cols - 1 - j) : j;
                        ctx.fillStyle = '#0f0'; // alien green
                        ctx.fillRect(x + px * scale, y + i * scale, scale, scale);
                    }
                }
            }
        }

        function drawPlayerSprite(x, y) {
            const rows = PLAYER_SPRITE.length;
            const cols = PLAYER_SPRITE[0].length;
            const scale = 2.5;
            for (let i = 0; i < rows; i++) {
                for (let j = 0; j < cols; j++) {
                    if (PLAYER_SPRITE[i][j] === '*') {
                        ctx.fillStyle = '#5faf5f';
                        ctx.fillRect(x + j * scale, y + i * scale, scale, scale);
                    }
                }
            }
        }

        function drawExplosion(x, y) {
            const rows = EXPLOSION.length;
            const cols = EXPLOSION[0].length;
            const scale = 2.5;
            for (let i = 0; i < rows; i++) {
                for (let j = 0; j < cols; j++) {
                    if (EXPLOSION[i][j] === '*') {
                        ctx.fillStyle = '#ff5a00';
                        ctx.fillRect(x + j * scale, y + i * scale, scale, scale);
                    }
                }
            }
        }

