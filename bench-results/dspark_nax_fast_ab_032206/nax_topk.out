Here's a complete Space Invaders game in Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self):
        self.rect = pygame.Rect(SCREEN_WIDTH // 2 - 25, SCREEN_HEIGHT - 50, 50, 25)
        self.speed = 5
        self.bullets = []
        self.lives = 3
        self.cooldown = 0
        self.shoot_cooldown = 20
        
    def move(self, dx):
        self.rect.x += dx * self.speed
        if self.rect.left < 0:
            self.rect.left = 0
        if self.rect.right > SCREEN_WIDTH:
            self.rect.right = SCREEN_WIDTH
            
    def shoot(self):
        if self.cooldown <= 0:
            bullet = Bullet(self.rect.centerx, self.rect.top, 0, -10)
            self.bullets.append(bullet)
            self.cooldown = self.shoot_cooldown
            
    def update(self):
        if self.cooldown > 0:
            self.cooldown -= 1
            
        for bullet in self.bullets[:]:
            bullet.update()
            if bullet.rect.bottom < 0:
                self.bullets.remove(bullet)
                
    def draw(self, screen):
        pygame.draw.rect(screen, GREEN, self.rect)
        for bullet in self.bullets:
            bullet.draw(screen)

class Alien:
    def __init__(self, x, y):
        self.rect = pygame.Rect(x, y, 40, 30)
        self.speed = 1
        self.direction = 1
        self.shoot_timer = random.randint(60, 300)
        
    def update(self):
        self.rect.x += self.speed * self.direction
        self.shoot_timer -= 1
        
    def draw(self, screen):
        # Draw a simple alien shape
        pygame.draw.ellipse(screen, RED, self.rect)
        
class Bullet:
    def __init__(self, x, y, speed_x, speed_y):
        self.rect = pygame.Rect(x - 2, y, 4, 10)
        self.speed_x = speed_x
        self.speed_y = speed_y
        
    def update(self):
        self.rect.x += self.speed_x
        self.rect.y += self.speed_y
        
    def draw(self, screen):
        pygame.draw.rect(screen, YELLOW, self.rect)

class SpaceInvaders:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock
