Here's a complete Space Invaders game in Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self):
        self.width = 60
        self.height = 20
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        # Draw triangle on top
        pygame.draw.polygon(screen, GREEN, 
            (self.x + self.width//2, self.y - 10),
            (self.x + self.width - 10, self.y + self.height//2),
            (self.x + 10, self.y + self.height//2))

class Enemy:
    def __init__(self, x, y):
        self.width = 30
        self.height = 20
        self.x = x
        self.y = y
        self.speed = 2
        self.direction = 1  # 1 for right, -1 for left
        
    def update(self):
        self.x += self.speed * self.direction
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        # Draw spikes
        pygame.draw.polygon(screen, RED, 
            (self.x + self.width//2, self.y - 10),
            (self.x + self.width - 10, self.y + self.height),
            (self.x + 10, self.y + self.height))

class Bullet:
    def __init__(self, x, y, speed=10):
        self.x = x
        self.y = y
        self.speed = speed
        self.width = 4
        self.height = 10
        
    def update(self):
        self.y -= self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, YELLOW, (self.x, self.y, self.width, self.height))
    
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

class EnemyBullet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.speed = 5
        self.width = 4
        self.height = 8
        
    def update(self):
        self.y += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
    
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

class Game:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock = pygame.time.Clock()
        self.player = Player()
        self.enemies = []
        self.bullets = []
        self.enemy_bullets = []
        self.running = True
        self.game_over = False
        self.wave = 1
        self.create_wave()
        
    def create_wave(self):
        """Create enemies for the current wave"""
        self.enemies = []
        for i in range(5):  # rows
            for j in range(10):  # columns
                x = 100 + j * 60
                y = 50 + i * 40
                enemy = Enemy(x, y)
                self.enemies.append(enemy)
    
