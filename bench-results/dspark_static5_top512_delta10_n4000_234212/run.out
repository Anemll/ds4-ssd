Here's a complete game of Space Invaders in Python using Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
PLAYER_WIDTH = 60
PLAYER_HEIGHT = 40
ENEMY_WIDTH = 50
ENEMY_HEIGHT = 40
BULLET_WIDTH = 4
BULLET_HEIGHT = 10
# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)

class Game:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock = pygame.time.Clock()
        self.running = True
        self.font = pygame.font.Font(None, 36)
        self.reset_game()
    
    def reset_game(self):
        # Player
        self.player_x = SCREEN_WIDTH // 2 - PLAYER_WIDTH // 2
        self.player_y = SCREEN_HEIGHT - 100
        self.player_speed = 0
        
        # Enemies
        self.enemies = []
        for i in range(5):
            for j in range(3):
                enemy = {
                    'x': i * (SCREEN_WIDTH // 5) + 50,
                    'y': j * 50 + 50,
                    'width': 50,
                    'height': 40,
                    'speed': 1.5 + j * 0.5,
                    'direction': 1 if i == 0 else -1
                }
                self.enemies.append(enemy)
        
        # Bullets
        self.bullets = []
        self.enemy_bullets = []
        
        # Score
        self.score = 0
        self.lives = 3
        
        # Game state
        self.game_over = False
        self.win = False
    
    def create_enemy(self):
        x = random.randint(0, SCREEN_WIDTH - ENEMY_WIDTH)
        y = random.randint(50, 200)
        return {
            'x': x,
            'y': y,
            'width': ENEMY_WIDTH,
            'height': ENEMY_HEIGHT,
            'speed': random.randint(1, 3),
            'direction': random.choice([-1, 1])
        }
    
    def handle_player(self):
        # Player movement
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT]:
            self.player_speed = -2
        elif keys[pygame.K_RIGHT]:
            self.player_speed = 2
        else:
            self.player_speed = 0
        
        self.player_x += self.player_speed
        self.player_x = max(0, min(self.player_x, SCREEN_WIDTH - PLAYER_WIDTH))
    
    def handle_bullets(self):
        # Player bullets
        for bullet in self.bullets[:]:
            bullet['y'] -= 5
            if bullet['y'] < 0:
                self.bullets.remove(bullet)
            # Check collision with enemies
            for enemy in self.enemies[:]:
                if (bullet['x'] >= enemy['x'] and bullet['x'] <= enemy['x'] + enemy['width'] and
                    bullet['y'] >= enemy['y'] and bullet['y'] <= enemy['y'] + enemy['height']):
                    self.bullets.remove(bullet)
                    self.enemies.remove(enemy)
                    self.score += 10
                    break
        
        # Enemy bullets
        for bullet in self.enemy_bullets[:]:
            bullet['y'] += 2
            if bullet['y'] > SCREEN_HEIGHT:
                self.enemy_bullets.remove(bullet)
            # Check if player is hit
            if (bullet['x'] >= self.player_x and bullet['x'] <= self.player_x + PLAYER_WIDTH and
                bullet['y'] >= self.player_y and bullet['y'] <= self.player_y + PLAYER_HEIGHT):
                self.lives -= 1
                self.enemy_bullets.remove(bullet)
                if self.lives <= 0:
                    self.game_over = True
    
    def handle_enemies(self):
        for enemy in self.enemies:
            # Move enemy
            enemy['x'] += enemy['speed'] * enemy['direction']
            
            # Bounce off walls
            if enemy['x'] <= 0 or enemy['x'] + enemy['width'] >= SCREEN_WIDTH:
                enemy['direction'] = -1 if enemy['direction'] == 1 else -1
                # Check if enemy reaches bottom
                if enemy['y'] + enemy['height'] >= SCREEN_HEIGHT - 100:
                    self.game_over = True
            
            # Enemy shoots
            if random.random() < 0.01:  # 1% chance
                self.enemy_bullets.append({
                    'x': enemy['x'] + enemy['width'] // 2 - BULLET_WIDTH // 2,
                    'y': enemy['y'] + enemy['height'],
                    'width': BULLET_WIDTH,
                    'height': BULLET_HEIGHT
                })
        
        # Check if enemies are empty
        if not self.enemies:
            self.win = True
    
    def draw_player(self):
        pygame.draw.rect(self.screen, RED, 
                        (self.player_x, self.player_y, PLAYER_WIDTH, PLAYER_HEIGHT))
        # Draw gun
        pygame.draw.rect(self.screen, RED,
                        (self.player_x + PLAYER_WIDTH // 2 - 5, 
                         self.player_y - 20, 10, 20))
    
    def draw_enemies(self):
        for enemy in self.enemies:
            # Draw a different color for each enemy
            color = (enemy['x'] * 100 % 255, enemy['y'] * 100 % 255, 255)
            pygame.draw.rect(self.screen, color, 
                          (enemy['x'], enemy['y'], enemy['width'], enemy['height']))
    
    def draw(self):
        self.screen.fill(BLACK)
        
        # Draw game
        self.draw_player()
        self.draw_enemies()
        
        # Draw bullets
        for bullet in self.bullets:
            pygame.draw.rect(self.screen, WHITE, 
                          (bullet['x'], bullet['y'], BULLET_WIDTH, BULLET_HEIGHT))
        for bullet in self.enemy_bullets:
            pygame.draw.rect(self.screen, RED, 
                          (bullet['x'], bullet['y'], BULLET_WIDTH, BULLET_HEIGHT))
        
        # Draw score
        score = self.font.render(f"Score: {self.score}", True, WHITE)
        self.screen.blit(score, (10, 10))
        
        # Draw lives
        lives = self.font.render(f"Lives: {self.lives}", True, WHITE)
        self.screen.blit(lives, (SCREEN_WIDTH - 100, 10))
        
        # Game over / Win
        if self.game_over:
            self.screen.blit(self.font.render("Game Over!", True, RED), 
                           (SCREEN_WIDTH // 2 - 50, SCREEN_HEIGHT // 2))
            self.screen.blit(self.font.render(f"Final Score: {self.score}", True, WHITE), 
                           (SCREEN_WIDTH // 2 - 50, SCREEN_HEIGHT // 2 + 20))
        elif self.win:
            self.screen.blit(self.font.render("You Win!", True, GREEN), 
                           (SCREEN_WIDTH // 2 - 50, SCREEN_HEIGHT // 2))
            self.screen.blit(self.font.render(f"Final Score: {self.score}", True, WHITE), 
                           (SCREEN_WIDTH // 2 - 50, SCREEN_HEIGHT // 2 + 20))
    
    def handle_event(self, event):
        if event.type == pygame.K_SPACE:
            if self.game_over or self.win:
                self.reset_game()
            else:
                self.bullets.append({
                    'x': self.player_x + PLAYER_WIDTH // 2 - BULLET_WIDTH // 2,
                    'y': self.player_y - 20,
                    'width': BULLET_WIDTH,
                    'height': BULLET_HEIGHT
                })
    
    def run(self):
        while self.running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE:
                    if not self.game_over and not self.win:
                        self.bullets.append({
                            'x': self.player_x + PLAYER_WIDTH // 2 - BULLET_WIDTH // 2,
                            'y': self.player_y - 20,
                            'width': BULLET_WIDTH,
                            'height': BULLET_HEIGHT
                        })
                    elif event.key == pygame.K_r:
                        self.reset_game()
            
            if not self.game_over and not self.win:
                self.handle_player()
                self.handle_bullets()
                self.handle_enemies()
            
            self.draw()
            self.clock.tick()
            pygame.display.flip()
        
        pygame.quit()

if __name__ == "__main__":
    game = Game()
    game.run()
```

This is a complete game of the classic game with the following features:

- **Player**: Player moves with arrow keys
- **Enemies**: Enemies move randomly
- **Bullets**: Player shoots with space
- **Score**: Score
- **Lives**: Lives
- **Game Over/Enemies**: Game over the game

The game is:
- Player controls
- Enemies move
- Player
- Enemies
- Score
- Lives
- Game over

To make it simple, I've added:
- Player movement
- Enemy movement
- Bullets
- Score
- Lives
- Game over

The game is a simple version of the classic. You can make it more complex.
