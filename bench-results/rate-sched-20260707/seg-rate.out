Here is a self-contained HTML file that recreates the classic 1978 Taito arcade experience of Space Invaders, with inline CSS and JS.
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPACE INVADERS · 1978</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            background: #0a0a0a;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            margin: 0;
            padding: 16px;
        }
        .cabinet {
            background: #111;
            border: 4px solid #444;
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(0, 200, 0, 0.2);
            padding: 20px 20px 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 780px;
            width: 100%;
        }
        .bezel {
            background: #000;
            border: 2px solid #33ff33;
            border-radius: 12px;
            padding: 12px 10px 10px;
            width: 100%;
            margin-bottom: 12px;
        }
        canvas {
            display: block;
            background: #000;
            width: 100%;
            height: auto;
            aspect-ratio: 640 / 720;
            border: 2px solid #33ff33;
            image-rendering: pixelated;
            cursor: none;
        }
        .controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px 40px;
            margin-top: 16px;
            color: #33ff33;
            font-weight: bold;
            text-shadow: 0 0 6px #00aa00;
            letter-spacing: 2px;
        }
        .controls span {
            background: #000;
            border: 1px solid #33ff33;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 6px;
        }
        .fire-btn {
            background: #330;
            border: 2px solid #ff33ff;
            color: #ff33ff;
            font-size: 1.4rem;
            padding: 6px 28px;
            border-radius: 40px;
            font-weight: bold;
            letter-spacing: 4px;
            box-shadow: 0 0 12px #ff33ff80;
            transition: 0.1s;
        }
        .fire-btn:active {
            background: #550;
            box-shadow: 0 0 20px #ff33ff;
        }
        .reset-btn {
            background: #111;
            border: 2px solid #33ff33;
            color: #33ff33;
            font-size: 1rem;
            padding: 6px 20px;
            border-radius: 30px;
            font-weight: bold;
        }
        .reset-btn:hover {
            background: #232;
        }
        .scoreboard {
            display: flex;
            justify-content: space-between;
            width: 100%;
            padding: 0 10px;
            margin-bottom: 6px;
            color: #33ff33;
            font-size: 1.2rem;
            font-weight: bold;
            text-shadow: 0 0 8px #00aa00;
        }
        .info {
            color: #33ff33;
            font-size: 0.85rem;
            margin-top: 6px;
            opacity: 0.9;
        }
        @media (max-width: 600px) {
            .controls span { font-size: 0.7rem; padding: 4px 10px; }
            .fire-btn { font-size: 1.1rem; padding: 4px 20px; }
        }
    </style>
</head>
<body>
<div class="cabinet">
    <div class="bezel">
        <div class="scoreboard">
            <span>🛸 SCORE</span>
            <span id="scoreDisplay">0000</span>
        </div>
        <canvas id="gameCanvas" width="640" height="720"></canvas>
    </div>
    <div class="controls">
        <span>← → MOVE</span>
        <span>⏎ FIRE</span>
        <span id="livesDisplay">💚💚💚</span>
    </div>
    <div class="btn-group">
        <button class="fire-btn" id="fireButton">⇽ FIRE ⇾</button>
        <button class="reset-btn" id="resetButton">↻ RESET</button>
    </div>
    <div class="info">▲ 1978 TAIKO · ORIGINAL RULES</div>
</div>

<script>
    (function() {
        // CANVAS SETUP
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreSpan = document.getElementById('scoreDisplay');
        const livesSpan = document.getElementById('livesDisplay');

        // GAME CONSTANTS (faithful to original)
        const ROWS = 5;          // 5 rows of invaders
        const COLS = 11;         // 11 columns
        const INVADER_WIDTH = 28;
        const INVADER_HEIGHT = 24;
        const PLAYER_WIDTH = 32;
        const PLAYER_HEIGHT = 20;
        const PLAYER_Y = 680;    // fixed Y position
        const INVADER_START_Y = 40;
        const INVADER_GAP = 8;

        // INVADER SPRITE (2 frames) - pixel art 28x24
        function drawInvader(x, y, frame, type) {
            // type 0 = top two rows (squid), 1 = middle (crab), 2 = bottom (crab)
            // simplified but distinct
            ctx.fillStyle = '#33ff33';
            ctx.shadowColor = '#33ff33';
            ctx.shadowBlur = 6;
            // body
            if (type === 0) { // squid
                ctx.fillRect(x+4, y+2, 20, 6);
                ctx.fillRect(x+6, y+8, 16, 8);
                ctx.fillRect(x+2, y+16, 24, 4);
                ctx.fillRect(x+6, y+20, 4, 4);
                ctx.fillRect(x+18, y+20, 4, 4);
                // legs
                if (frame === 0) {
                    ctx.fillRect(x+2, y+20, 2, 6);
                    ctx.fillRect(x+24, y+20, 2, 6);
                } else {
                    ctx.fillRect(x+8, y+20, 2, 6);
                    ctx.fillRect(x+18, y+20, 2, 6);
                }
            } else if (type === 1) { // crab
                ctx.fillRect(x+2, y+2, 24, 6);
                ctx.fillRect(x+6, y+8, 16, 10);
                ctx.fillRect(x+2, y+18, 24, 4);
                ctx.fillRect(x+0, y+10, 4, 6);
                ctx.fillRect(x+24, y+10, 4, 6);
                if (frame === 0) {
                    ctx.fillRect(x+0, y+20, 2, 6);
                    ctx.fillRect(x+26, y+20, 2, 6);
                } else {
                    ctx.fillRect(x+6, y+20, 2, 6);
                    ctx.fillRect(x+20, y+20, 2, 6);
                }
            } else { // crab bottom (same but smaller)
                ctx.fillRect(x+4, y+2, 20, 6);
                ctx.fillRect(x+6, y+8, 16, 10);
                ctx.fillRect(x+4, y+18, 20, 4);
                ctx.fillRect(x+2, y+10, 4, 6);
                ctx.fillRect(x+22, y+10, 4, 6);
                if (frame === 0) {
                    ctx.fillRect(x+2, y+20, 2, 6);
                    ctx.fillRect(x+24, y+20, 2, 6);
                } else {
                    ctx.fillRect(x+8, y+20, 2, 6);
                    ctx.fillRect(x+18, y+20, 2, 6);
                }
            }
            ctx.shadowBlur = 0;
        }

        // PLAYER sprite (simple cannon)
        function drawPlayer(x, y) {
            ctx.fillStyle = '#33ff33';
            ctx.shadowColor = '#33ff33';
            ctx.shadowBlur = 8;
            ctx.fillRect(x+4, y+2, 24, 4);
            ctx.fillRect(x+8, y+6, 16, 8);
            ctx.fillRect(x+12, y+14, 8, 6);
            ctx.fillRect(x+2, y+6, 4, 10);
            ctx.fillRect(x+26, y+6, 4, 10);
            ctx.shadowBlur = 0;
        }

        // BULLET
        function drawBullet(x, y) {
            ctx.fillStyle = '#ff33ff';
            ctx.shadowColor = '#ff33ff';
            ctx.shadowBlur = 10;
            ctx.fillRect(x, y, 4, 12);
            ctx.shadowBlur = 0;
        }

        // GAME STATE
        let gameActive = false;
        let score = 0;
        let lives = 3;
        let level = 1;

        // invaders array
        let invaders = [];
        let invaderDir = 1;          // 1 = right, -1 = left
        let invaderSpeed = 1.2;      // base speed (increases with level)
        let invaderMoveCounter = 0;
        let frameSwitch = 0;         // 0/1 animation

        // player
        let playerX = 304;           // (640-32)/2
        let playerBullet = null;     // {x, y, active}
        let bulletActive = false;

        // invaders bullets
        let invaderBullets = [];
        const MAX_INVADER_BULLETS = 3;

        // timing
        let lastTimestamp = 0;
        let gameLoopId = null;
        let moveTimer = 0;
        const MOVE_DELAY = 180;      // ms between
