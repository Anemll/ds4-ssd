                } else {
                    ctx.fillRect(x+6, y+14, 6, 6);
                    ctx.fillRect(x+16, y+14, 6, 6);
                }
                // eyes
                ctx.fillStyle = '#ff0';
                ctx.fillRect(x+8, y+4, 4, 4);
