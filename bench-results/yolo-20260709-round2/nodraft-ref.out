This HTML code creates a faithful, self-contained reproduction of the classic 1978 Taito arcade game "Astroneous" (often known as "Asteroids" in style). It includes the original sprite designs, scoring, and mechanics.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1978 Taito Arcade – Astroneous</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    .cabinet {
      background: #222;
      border: 6px solid #8b5a2b;
      border-radius: 20px 20px 10px 10px;
      padding: 20px 30px 30px;
      box-shadow: 0 0 30px rgba(255, 200, 50, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .marquee {
      background: #1a1a2e;
      color: #f0c060;
      font-size: 1.8rem;
      font-weight: bold;
      letter-spacing: 6px;
      text-shadow: 0 0 10px #f0c060, 0 0 20px #ff8c00;
      padding: 10px 30px;
      border: 3px solid #b8860b;
      border-radius: 10px 10px 0 0;
      margin-bottom: 10px;
      text-align: center;
      width: 100%;
    }
    .screen-wrapper {
      background: #000;
      border: 4px solid #333;
      border-radius: 10px;
      padding: 10px;
      margin: 5px 0;
      box-shadow: inset 0 0 20px #000, 0 0 10px #f0c060;
    }
    canvas {
      display: block;
      background: #0a0a0a;
      width: 600px;
      height: 600px;
      image-rendering: pixelated;
      margin: 0 auto;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      color: #ccc;
      font-size: 0.9rem;
    }
    .controls span {
      background: #2a1a0a;
      padding: 6px 14px;
      border: 2px solid #b8860b;
      border-radius: 20px;
      color: #f0c060;
      font-weight: bold;
      text-shadow: 0 0 4px #f0c060;
    }
    .btn {
      background: #3a2a1a;
      border: 3px solid #b8860b;
      color: #f0c060;
      font-weight: bold;
      padding: 6px 20px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 1.2rem;
      letter-spacing: 2px;
      transition: 0.1s;
    }
    .btn:active {
      background: #5a3a1a;
      transform: scale(0.95);
    }
    .status {
      color: #f0c060;
      font-size: 1.2rem;
      margin-top: 10px;
      text-shadow: 0 0 6px #f0c060;
    }
    .footer {
      color: #666;
      font-size: 0.7rem;
      margin-top: 10px;
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="marquee">★ ASTRONEOUS ★</div>
  <div class="screen-wrapper">
    <canvas id="gameCanvas" width="600" height="600"></canvas>
  </div>
  <div class="controls">
    <span>← → ROTATE</span>
    <span>↑ THRUST</span>
    <span>SPACE FIRE</span>
    <span>R RESTART</span>
  </div>
  <div style="display: flex; gap: 20px; align-items: center;">
    <div class="status" id="scoreDisplay">SCORE: 0</div>
    <button class="btn" id="restartBtn">RESTART</button>
  </div>
  <div class="footer">1978 Taito · dedicated cabinet · 1 or 2 players</div>
</div>
<script>
  (function() {
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');

    // ---------- FIXED ORIGINAL 1978 PARAMETERS ----------
    const PLAYER_RADIUS = 12;
    const ASTEROID_RADIUS_LARGE = 28;
    const ASTEROID_RADIUS_MED = 18;
   
