This HTML code creates a faithful, self-contained reproduction of the classic 1978 Taito arcade game "Astrans" (a fictional name for this exercise) within a single file. It includes the original rules, sprite designs, and mechanics.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1978 Taito Arcade – Astrans</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    .cabinet {
      background: #222;
      border: 6px solid #8b5a2b;
      border-radius: 20px 20px 10px 10px;
      padding: 20px 30px 30px;
      box-shadow: 0 0 30px rgba(255, 200, 50, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .marquee {
      background: #1a1a2e;
      color: #f0c060;
      font-size: 2.2rem;
      font-weight: bold;
      letter-spacing: 6px;
      text-shadow: 0 0 10px #f0c060, 0 0 20px #ff8c00;
      padding: 10px 30px;
      border: 3px solid #b8860b;
      border-radius: 10px 10px 0 0;
      margin-bottom: 10px;
      text-align: center;
      width: 100%;
    }
    .screen-wrapper {
      background: #000;
      border: 6px solid #333;
      border-radius: 10px;
      padding: 10px;
      margin: 5px 0;
      box-shadow: inset 0 0 20px #000, 0 0 10px #f0c06040;
    }
    canvas {
      display: block;
      background: #0a0a0a;
      width: 640px;
      height: 480px;
      image-rendering: pixelated;
      border: 2px solid #5a3e1a;
    }
    .controls {
      display: flex;
      gap: 40px;
      margin-top: 20px;
      color: #ddd;
      font-size: 1.1rem;
      background: #2b1a0e;
      padding: 10px 30px;
      border-radius: 20px;
      border: 2px solid #b8860b;
    }
    .controls span {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .key {
      background: #444;
      border: 2px solid #888;
      border-radius: 6px;
      padding: 2px 10px;
      color: #ffd966;
      font-weight: bold;
    }
    .btn {
      background: #c8411a;
      border: 3px solid #ff6e1e;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      box-shadow: 0 0 10px #ff6e1e80;
    }
    .info {
      color: #bdb76b;
      font-size: 0.9rem;
      margin-top: 10px;
      text-align: center;
      border-top: 2px solid #6b4a2b;
      padding-top: 8px;
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="marquee">★ ASTRANS ★</div>
  <div class="screen-wrapper">
    <canvas id="gameCanvas" width="640" height="480"></canvas>
  </div>
  <div class="controls">
    <span><span class="key">← →</span> move</span>
    <span><span class="key">↑</span> thrust</span>
    <span><span class="key">Z</span> fire</span>
    <span><span class="key">R</span> restart</span>
  </div>
  <div class="info">1978 Taito · original rules · sprite fidelity</div>
</div>
<script>
  (function() {
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // ---------- CONSTANTS ----------
    const W = 640, H = 480;
    const PLAYER_RADIUS = 14;
    const ASTEROID_RADII = [24, 18, 12];
    const UFO_RADIUS = 20;
    const MAX_BULLETS = 6;
    const MAX_UFO_BULLETS = 4;
    const PLAYER_ACCEL = 0.2;
    const PLAYER_FRICTION = 0.98;
    const PLAYER_MAX_SPEED = 5;
    const BULLET_SPEED = 6;
    const UFO_BULLET_SPEED = 3.5;
    const UFO_FIRE_RATE = 40; // frames between shots
    const UFO_SPEED = 1.5;
    const ASTEROID_SPEED = 1.8;
    const RESPAWN_DELAY = 90; // frames

    // ---------- GAME STATE ----------
    let player = {
      x: 320, y: 440, vx: 0, vy: 0, angle: -90, // up
      radius: PLAYER_RADIUS, active: true, respawnTimer: 0
    };
    let bullets = [];
    let ufoBullets = [];
    let asteroids = [];
    let ufo = { x: 0, y: 0, active: false, timer: 0, angle: 0, vx: 0, vy: 0, fireTimer: 0 };
    let score = 0;
    let lives = 3;
    let gameOver = false;
    let frame = 0;

    // ---------- HELPER: random between ----------
    function rand(min, max) { return Math.random() * (max - min) + min; }

    // ---------- INIT / RESET ----------
    function resetGame() {
      player.x = 320; player.y = 440; player.vx = 0; player.vy = 0;
      player.angle = -90; player.active = true; player.respawnTimer = 0;
      bullets = [];
      ufoBullets = [];
      asteroids = [];
      ufo.active = false; ufo.timer = 0; ufo.fireTimer = 0;
      score = 0; lives = 3; gameOver = false;
      // spawn initial asteroids
      for (let i = 0; i < 6; i++) {
        spawnAsteroid(true);
      }
      // ensure no asteroid on player start
      clearAsteroidNearPlayer();
    }

    function clearAsteroidNearPlayer() {
      const px = 320, py = 440;
      for (let i = 0; i < asteroids.length; i++) {
        const a = asteroids[i];
        const dx = a.x - px, dy = a.y - py;
        if (Math.hypot(dx, dy) < 80) {
          a.x = rand(30, 610); a.y = rand(20, 300);
          a.vx = rand(-1, 1) * ASTEROID_SPEED;
          a.vy = rand(-1, 1) * ASTEROID_SPEED;
        }
      }
    }

    // ---------- SPAWN ASTEROID ----------
    function spawnAsteroid(initial = false) {
      let x, y, vx, vy;
      if (initial) {
        x = rand(30, 610); y = rand(20, 300);
        vx = rand(-1, 1) * ASTEROID_SPEED;
        vy = rand(-1, 1) * ASTEROID_SPEED;
      } else {
        // spawn from edges
        const side = Math.floor(Math.random() * 4);
        if (side === 0) { x = rand(10, 630); y = 10; }
        else if (side === 1) { x = rand(10, 630); y = 470; }
        else if (side === 2) { x = 10; y = rand(10, 470); }
        else { x = 630; y = rand(10, 470); }
        vx = rand(-1, 1) * ASTEROID_SPEED;
        vy = rand(-1, 1) * ASTEROID_SPEED;
      }
      const size = Math.floor(Math.random() * 3); // 0,1,2
      const r = ASTEROID_RADII[size];
      asteroids.push({ x, y, vx, vy, radius: r, size, hp: size+1 });
    }

    // ---------- UFO ----------
    function spawnUfo() {
      const side = Math.floor(Math.random() * 4);
      let x, y, vx, vy;
      if (side === 0) { x = rand(20, 620); y = 20; vx = rand(-0.5, 0.5); vy = 1; }
      else if (side === 1) { x = rand(20, 620); y = 460; vx = rand(-0.5, 0.5); vy = -1; }
      else if (side === 2) { x = 20; y = rand(20, 460); vx = 1; vy = rand(-0.5, 0.5); }
      else { x = 620; y = rand(20, 460); vx = -1; vy = rand(-0.5, 0.5); }
      ufo.active = true;
      ufo.x = x; ufo.y = y; ufo.vx = vx * UFO_SPEED; ufo.vy = vy * UFO_SPEED;
      ufo.fireTimer = 0;
      ufo.timer = 0;
    }

    // ---------- DRAW SPRITES (original 1978 style) ----------
    function drawPlayer(x, y, angle) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle * Math.PI / 180);
      // retro pixel ship: triangle with detail
      ctx.fillStyle = '#b0f0ff';
      ctx.shadowColor = '#7fcaff';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.moveTo(0, -18);
      ctx.lineTo(-12, 12);
      ctx.lineTo(0, 6);
      ctx.lineTo(12, 12);
      ctx.closePath();
      ctx.fill();
      // cockpit
      ctx.fillStyle = '#ffd966';
      ctx.shadowBlur = 4;
      ctx.beginPath();
      ctx.arc(0, -4, 5, 0, Math.PI*2);
      ctx.fill();
      // wings detail
      ctx.fillStyle = '#8fcaff';
      ctx.shadowBlur = 0;
      ctx.beginPath();
      ctx.rect(-14, 8, 4, 6);
      ctx.rect(10, 8, 4, 6);
      ctx.fill();
      ctx.restore();
    }

    function drawAsteroid(a) {
      const r = a.radius;
      ctx.save();
      ctx.translate(a.x, a.y);
      // jagged polygon (original style)
      const points = 8;
      const angleStep = Math.PI * 2 / points;
      ctx.beginPath();
      for (let i = 0; i < points; i++) {
        const ang = i * angleStep + a.vx * 0.1; // wobble
        const len = r * (0.7 + 0.3 * Math.sin(i * 3 + a.vx * 0.5));
        const xOff = Math.cos(ang) * len;
        const yOff = Math.sin(ang) * len;
        if (i === 0) ctx.moveTo(xOff, yOff);
        else ctx.lineTo(xOff, yOff);
      }
      ctx.closePath();
      ctx.fillStyle = '#8b6b4a';
      ctx.strokeStyle = '#5a3e1a';
      ctx.lineWidth = 2;
      ctx.shadowBlur = 6;
      ctx.shadowColor = '#3a2a1a';
      ctx.fill();
      ctx.stroke();
      // highlight
      ctx.fillStyle = '#b08a5a';
      ctx.beginPath();
      ctx.arc(-3, -3, 5, 0, Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    function drawUfo(u) {
      ctx.save();
      ctx.translate(u.x, u.y);
      // classic saucer
      ctx.fillStyle = '#c0a040';
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#f0c060';
      ctx.beginPath();
      ctx.ellipse(0, 0, 24, 10, 0, 0, Math.PI*2);
      ctx.fill();
      ctx.fillStyle = '#a08030';
      ctx.beginPath();
      ctx.ellipse(0, -6, 16, 6, 0, 0, Math.PI*2);
      ctx.fill();
      // dome
      ctx.fillStyle = '#80c0f0';
      ctx.shadowBlur = 6;
      ctx.beginPath();
      ctx.arc(0, -8, 8, 0, Math.PI*2);
      ctx.fill();
      // lights
      ctx.fillStyle = '#ffd966';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(-10, -2, 3, 0, Math.PI*2);
      ctx.arc(10, -2, 3, 0, Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    function drawBullet(b) {
      ctx.save();
      ctx.fillStyle = '#ff6e1e';
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#ff8c00';
      ctx.beginPath();
      ctx.arc(b.x, b.y, 3, 0, Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    function drawUfoBullet(b) {
      ctx.save();
      ctx.fillStyle = '#ff2020';
      ctx.shadowBlur = 12;
      ctx.shadowColor = '#ff0000';
      ctx.beginPath();
      ctx.arc(b.x, b.y, 4, 0, Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    // ---------- COLLISION & GAME LOGIC ----------
    function handleCollisions() {
      // player vs asteroids
      if (player.active) {
        for (let i = 0; i < asteroids.length; i++) {
          const a = asteroids[i];
          const dx = player.x - a.x, dy = player.y - a.y;
          const dist = Math.hypot(dx, dy);
          if (dist < player.radius + a.radius) {
            // destroy asteroid, player dies
            score += 10 * (3 - a.size);
            asteroids.splice(i, 1);
            i--;
            player.active = false;
            player.respawnTimer = RESPAWN_DELAY;
            lives--;
            if (lives <= 0) gameOver = true;
            break;
          }
        }
      }
      // bullets vs asteroids
      for (let b = 0; b < bullets.length; b++) {
        const bullet = bullets[b];
        for (let i = 0; i < asteroids.length; i++) {
          const a = asteroids[i];
          const dx = bullet.x - a.x, dy = bullet.y - a.y;
          if (Math.hypot(dx, dy) < a.radius + 4) {
            bullets.splice(b, 1); b--;
            // destroy asteroid
            score += 10 * (3 - a.size);
            asteroids.splice(i, 1);
            // spawn two smaller if size > 0
            if (a.size > 0) {
              const newSize = a.size - 1;
              const r = ASTEROID_RADII[newSize];
              for (let k = 0; k < 2; k++) {
                asteroids.push({
                  x: a.x + rand(-10,10), y: a.y + rand(-10,10),
                  vx: rand(-1,1) * ASTEROID_SPEED * 0.8,
                  vy: rand(-1,1) * ASTEROID_SPEED * 0.8,
                  radius: r, size: newSize, hp: newSize+1
                });
              }
            }
            break;
          }
        }
      }
      // player vs ufo
      if (player.active && ufo.active) {
        const dx = player.x - ufo.x, dy = player.y - ufo.y;
        if (Math.hypot(dx, dy) < player.radius + UFO_RADIUS) {
          player.active = false;
          player.respawnTimer = RESPAWN_DELAY;
          lives--;
          ufo.active = false;
          if (lives <= 0) gameOver = true;
        }
      }
      // bullets vs ufo
      for (let b = 0; b < bullets.length; b
