Here's a complete Space Invaders game in Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self):
        self.width = 60
        self.height = 20
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        # Draw triangle on top
        pygame.draw.polygon(screen, GREEN, 
                          [(self.x + self.width//2, self.y - 10),
                           (self.x + self.width - 10, self.y),
                           (self.x + 10, self.y)])

class Enemy:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 40
        self.height = 30
        self.speed = 1
        self.direction = 1  # 1 for right, -1 for left
        
    def update(self):
        self.x += self.speed * self.direction
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        # Draw antennas
        pygame.draw.line(screen, WHITE, (self.x + 10, self.y), 
                        (self.x + 10, self.y - 10), 2)
        pygame.draw.line(screen, WHITE, (self.x + 30, self.y), 
                        (self.x + 30, self.y - 10), 2)

class Bullet:
    def __init__(self, x, y, speed=5):
        self.x = x
        self.y = y
        self.speed = speed
        self.width = 4
        self.height = 10
        
    def update(self):
        self.y -= self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, YELLOW, (self.x, self.y, self.width, self.height))

class EnemyBullet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.speed = 3
        self.width = 4
        self.height = 8
        
    def update(self):
        self.y += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))

class SpaceInvaders:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock = pygame.time.Clock()
        self.running = True
        self.font = pygame.font.Font(None, 36)
        self.small_font = pygame.font.Font(None, 24)
        
        # Game objects
        self.player = Player()
        self.enemies = []
        self.bullets = []
        self.enemy_bullets = []
        self.create_enemies()
        
        # Game state
        self.enemy_direction = 1
        self.enemy_speed = 1
        self.enemy_drop = 0
        self.shoot_timer = 0
        
    def create_enemies(self):
        for row in range(5):
            for col in range(10):
                x = 50 + col * 70
                y = 50 + row * 40
                enemy = Enemy(x, y)
                self.enemies.append(enemy)
    
    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
