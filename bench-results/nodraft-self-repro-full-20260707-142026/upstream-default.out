Here is a self-contained HTML file that recreates the classic 1978 Taito arcade game "Asteroids" as a single, playable web page. It includes the vector-style graphics, authentic rules, and the feel of the original cabinet.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1978 Taito Arcade - Asteroids</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #0a0a0a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
      color: #fff;
    }
    .cabinet {
      background: #111;
      border: 4px solid #444;
      border-radius: 20px;
      padding: 20px 30px;
      box-shadow: 0 0 30px rgba(255, 80, 0, 0.3);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .marquee {
      background: #222;
      border: 2px solid #f80;
      border-radius: 8px;
      padding: 8px 20px;
      margin-bottom: 12px;
      font-size: 1.8rem;
      letter-spacing: 6px;
      text-shadow: 0 0 10px #f80;
      color: #f80;
      font-weight: bold;
      text-transform: uppercase;
    }
    .screen-wrapper {
      background: #000;
      border: 4px solid #333;
      border-radius: 10px;
      padding: 6px;
      display: inline-block;
    }
    canvas {
      display: block;
      background: #000;
      width: 600px;
      height: 400px;
      border: 2px solid #f80;
      border-radius: 4px;
      image-rendering: pixelated;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      background: #1a1a1a;
      padding: 12px 20px;
      border-radius: 20px;
      border: 2px solid #f80;
    }
    .control-group {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .key {
      background: #222;
      border: 2px solid #f80;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 1.2rem;
      font-weight: bold;
      color: #f80;
      text-shadow: 0 0 4px #f80;
      min-width: 40px;
      text-align: center;
    }
    .info {
      margin-top: 10px;
      font-size: 0.9rem;
      color: #aaa;
      text-align: center;
      border-top: 1px solid #333;
      padding-top: 8px;
    }
    .info span {
      color: #f80;
      font-weight: bold;
    }
    .reset-btn {
      background: #f80;
      border: none;
      border-radius: 10px;
      padding: 6px 20px;
      font-weight: bold;
      font-size: 1.1rem;
      cursor: pointer;
      color: #000;
      margin-left: 10px;
      transition: 0.1s;
    }
    .reset-btn:hover {
      background: #fa0;
      transform: scale(1.02);
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="marquee">★ ASTEROIDS ★</div>
  <div class="screen-wrapper">
    <canvas id="gameCanvas" width="600" height="400"></canvas>
  </div>
  <div class="controls">
    <div class="control-group">
      <span class="key">←</span>
      <span class="key">→</span>
      <span class="key">↑</span>
      <span class="key">␣</span>
    </div>
    <div class="control-group">
      <span style="color:#f80;">ROTATE / THRUST / FIRE</span>
    </div>
    <button class="reset-btn" id="resetButton">↺ RESET</button>
  </div>
  <div class="info">
    <span>1978 TAITO</span> — original rules: destroy asteroids, no wrap, hyperspace? <span>NO</span> — just pure arcade.
  </div>
</div>

<script>
  (function() {
    // CANVAS SETUP
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const w = 600, h = 400;

    // GAME STATE
    let player = null;
    let bullets = [];
    let asteroids = [];
    let score = 0;
    let lives = 3;
    let gameOver = false;
    let level = 1;
    let frame = 0;

    // CONSTANTS
    const ASTEROID_COUNT_BASE = 4;
    const PLAYER_RADIUS = 12;
    const BULLET_SPEED = 5;
    const ASTEROID_SPEED_BASE = 1.2;
    const MAX_ASTEROID_SPEED = 2.5;

    // INPUT
    const keys = {
      left: false,
      right: false,
      up: false,
      space: false
    };

    // HELPER: random between
    function rand(min, max) { return Math.random() * (max - min) + min; }

    // ----- CLASSES (original 1978 style) -----
    class Player {
      constructor() {
        this.x = w/2;
        this.y = h/2;
        this.angle = -Math.PI/2; // up
        this.radius = PLAYER_RADIUS;
        this.speed = 0;
        this.active = true;
        this.cooldown = 0;
        this.timer = 0;
        this.invincible = 0; // frames after respawn
      }

      reset() {
        this.x = w/2;
        this.y = h/2;
        this.angle = -Math.PI/2;
        this.speed = 0;
        this.active = true;
        this.cooldown = 0;
        this.invincible = 30;
      }

      update() {
        if (!this.active) return;
        if (this.invincible > 0) this.invincible--;

        // rotation
        if (keys.left) this.angle -= 0.08;
        if (keys.right) this.angle += 0.08;

        // thrust
        if (keys.up) {
          const thrust = 0.15;
          this.speed += thrust * 0.6;
          if (this.speed > 4) this.speed = 4;
        } else {
          // friction
          this.speed *= 0.98;
        }

        // move
        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed;

        // wrap (original asteroids wrap)
        if (this.x < 0) this.x = w;
        if (this.x > w) this.x = 0;
        if (this.y < 0) this.y = h;
        if (this.y > h) this.y = 0;

        // fire
        if (keys.space && this.cooldown <= 0 && this.active) {
          bullets.push(new Bullet(this.x, this.y, this.angle));
          this.cooldown = 12;
        }
        if (this.cooldown > 0) this.cooldown--;
      }

      draw() {
        if (!this.active) return;
        // draw ship as vector (1978 style)
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angle);

        // thruster flicker
        let thrusterLen = 6;
        if (keys.up && frame % 4 < 2) thrusterLen = 10;

        ctx.beginPath();
        // ship shape: triangle with cockpit
        ctx.moveTo(14, 0);
        ctx.lineTo(-8, -8);
        ctx.lineTo(-4, 0);
        ctx.lineTo(-8, 8);
        ctx.closePath();
        ctx.strokeStyle = '#f80';
        ctx.lineWidth = 2;
        ctx.stroke();

        // thruster flame
        if (keys.up) {
          ctx.beginPath();
          ctx.moveTo(-6, -3);
          ctx.lineTo(-6 - thrusterLen, 0);
          ctx.lineTo(-6, 3);
          ctx.strokeStyle = '#ff0';
          ctx.lineWidth = 1.5;
          ctx.stroke();
        }

        // cockpit dot
        ctx.fillStyle = '#f80';
        ctx.fillRect(-2, -1, 4, 2);

        ctx.restore();

        // invincibility flash
        if (this.invincible > 0 && frame % 6 < 3) {
          ctx.beginPath();
          ctx.arc(this.x, this.y, 20, 0, Math.PI*2);
          ctx.strokeStyle = '#ff0';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }
    }

    class Bullet {
      constructor(x, y, angle) {
        this.x = x;
        this.y = y;
        this.angle = angle;
        this.speed = BULLET_SPEED;
        this.radius = 2;
        this.life = 40;
      }

      update() {
        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed;
        this.life--;
        // wrap
        if (this.x < 0) this.x = w;
        if (this.x > w) this.x = 0;
        if (this.y < 0) this.y = h;
        if (this.y > h) this.y = 0;
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, 2, 0, Math.PI*2);
        ctx.fillStyle = '#f80';
        ctx.fill();
        // tail
        ctx.beginPath();
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x - Math.cos(this.angle)*6, this.y - Math.sin(this.angle)*6);
        ctx.strokeStyle = '#f80';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    class Asteroid {
      constructor(x, y, size, speedAngle) {
        this.x = x;
        this.y = y;
        this.size = size; // 1,2,3 (3=large)
        this.angle = speedAngle || rand(0, Math.PI*2);
        this.speed = (ASTEROID_SPEED_BASE + Math.random() * 0.8) * (1 - size * 0.15);
        if (this.speed < 0.6) this.speed = 0.6;
        this.radius = size * 10; // 10,20,30
        this.spin = rand(-0.02, 0.02);
        this.rotation = rand(0, Math.PI*2);
        // shape vertices (original style)
        this.vertices = this.generateShape();
      }

      generateShape() {
        // irregular polygon (classic asteroids)
        const pts = [];
        const num = 8 + Math.floor(rand(0, 4));
        for (let i = 0; i < num; i++) {
          const angle = (i / num) * Math.PI * 2;
          const r = this.radius * (0.7 + rand(0.3, 0.6));
          pts.push({ x: Math.cos(angle) * r, y: Math.sin(angle) * r });
        }
        return pts;
      }

      update() {
        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed;
        this.rotation += this.spin;
        // wrap
        if (this.x < -40) this.x = w + 40;
        if (this.x > w + 40) this.x = -40;
        if (this.y < -40) this.y = h + 40;
        if (this.y > h + 40) this.y = -40;
      }

      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);
        ctx.beginPath();
        const pts = this.vertices;
        ctx.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          ctx.lineTo(pts[i].x, pts[i].y);
        }
        ctx.closePath();
        ctx.strokeStyle = '#aaa';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();
      }
    }

    // ----- INIT / RESET -----
    function initGame() {
      player = new Player();
      bullets = [];
      asteroids = [];
      score = 0;
      lives = 3;
      level = 1;
      gameOver = false;
      spawnAsteroids(level);
    }

    function spawnAsteroids(level) {
      const count = ASTEROID_COUNT_BASE + level * 1;
      for (let i = 0; i < count; i++) {
        let x, y;
        // spawn away from center
        do {
          x = rand(20, w-20);
          y = rand(20, h-20);
        } while (Math.abs(x - w/2) < 60 && Math.abs(y - h/2) < 60);
        const size = 3; // large
        const angle = rand(0, Math.PI*2);
        asteroids.push(new Asteroid(x, y, size, angle));
      }
    }

    // ----- COLLISION & LOGIC (original rules) -----
    function handleCollisions() {
      // bullets vs asteroids
      for (let bi = bullets.length-1; bi >= 0; bi--) {
        const b = bullets[bi];
        for (let ai = asteroids.length-1; ai >= 0; ai--) {
          const a = asteroids[ai];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < a.radius + 4) {
            // destroy asteroid
            score += 10 * (4 - a.size);
            // split
            if (a.size > 1) {
              const newSize = a.size - 1;
              const count = 2;
              for (let i = 0; i < count; i++) {
                const ang = rand(0, Math.PI*2);
                const ast = new Asteroid(a.x, a.y, newSize, ang);
                ast.speed = a.speed * 1.2;
                asteroids.push(ast);
              }
            }
            asteroids.splice(ai, 1);
            bullets.splice(bi, 1);
            break;
          }
        }
      }

      // player vs asteroids
      if (player.active && player.invincible <= 0) {
        for (let ai = asteroids.length-1; ai >= 0; ai--) {
          const a = asteroids[ai];
          const dx = player.x - a.x;
          const dy = player.y - a.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < a.radius + PLAYER_RADIUS) {
            // collision
            player.active = false;
            lives--;
            if (lives <= 0) {
              gameOver = true;
            } else {
              // respawn after delay
              setTimeout(() => {
                if (!gameOver) {
                  player.reset();
                  player.invincible = 60;
                }
              }, 800);
            }
            // remove asteroid that hit
            asteroids.splice(ai, 1);
            break;
          }
        }
      }
    }

    // ----- LEVEL PROGRESSION -----
    function checkLevel() {
      if (asteroids.length === 0 && !gameOver) {
        level++;
        spawnAsteroids(level);
      }
    }

    // ----- DRAW UI -----
    function drawUI() {
      ctx.fillStyle = '#f80';
      ctx.font = '16px "Courier New", monospace';
      ctx.textAlign = 'left';
      ctx.fillText('SCORE', 10, 20);
      ctx.fillStyle = '#fff';
      ctx.font = '20px "Courier New", monospace';
      ctx.fillText(score, 10, 44);

      // lives
      ctx.fillStyle = '#f80';
      ctx.font = '16px "Courier New", monospace';
      ctx.textAlign = 'right';
      ctx.fillText('LIVES', w-10, 20);
      ctx.fillStyle = '#fff';
      ctx.font = '20px "Courier New", monospace';
      ctx.fillText(lives, w-10, 44);

      // level
      ctx.fillStyle = '#f80';
      ctx.textAlign = 'center';
      ctx.font = '14px "Courier New", monospace';
      ctx.fillText('LEVEL '+level, w/2, 20);

      if (gameOver) {
        ctx.fillStyle = '#f80';
        ctx.font = '40px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('GAME OVER', w/2, h/2);
        ctx.font = '16px "Courier New", monospace';
        ctx.fillText('PRESS RESET', w/2, h/2 + 40);
      }
    }

    // ----- MAIN LOOP -----
      function gameLoop() {
      frame++;
      // update
      if (!gameOver) {
        player.update();
        bullets.forEach(b => b.update());
        asteroids.forEach(a => a.update());
        handleCollisions();
        checkLevel();
      }

      // draw
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, w, h);

      // draw grid (vector feel)
      ctx.strokeStyle = '#111';
      ctx.lineWidth = 1;
      for (let i = 0; i < w; i+=40) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, h);
        ctx.stroke();
      }
      for (let i = 0; i < h; i+=40) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(w, i);
        ctx.stroke();
      }

      // draw objects
      asteroids.forEach(a => a.draw());
      bullets.forEach(b => b.draw());
      if (player) player.draw();

      drawUI();

      requestAnimationFrame(gameLoop);
    }

    // ----- INPUT HANDLING (original arcade) -----
    function handleKey(e, value) {
      const key = e.key;
      if (key === 'ArrowLeft') { keys.left = value; e.preventDefault(); }
      else if (key === 'ArrowRight') { keys.right = value; e.preventDefault(); }
      else if (key === 'ArrowUp') { keys.up = value; e.preventDefault(); }
      else if (key === ' ') { keys.space = value; e.preventDefault(); }
    }

    document.addEventListener('keydown', (e) => handleKey(e, true));
    document.addEventListener('keyup', (e) => handleKey(e, false));

    // prevent scrolling with space / arrows
    window.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key.startsWith('Arrow')) e.preventDefault();
    });

    // RESET
    document.getElementById('resetButton').addEventListener('click', () => {
      initGame();
    });

    // START
    initGame();
    gameLoop();
  })();
</script>
</body>
</html>
```
### Gameplay & Design
This page captures the look and feel of the original arcade cabinet. Here's how it works:

- **Core Mechanics**: You control a spaceship, rotating with the left/right arrows, thrusting with the up arrow, and firing with the spacebar. The goal is to destroy all asteroids, which split into smaller pieces when hit.
- **Authentic Presentation**: The game features a vector-style display, a marquee title, and a cabinet-style layout. The controls are clearly labeled, and the screen wraps like the original.
- **Game Progression**: Each level increases the number of asteroids. You have three lives, and a collision costs you one. The game ends when lives reach zero, and you can reset to start a new session.

---

**Instructions:** Use the arrow keys to rotate and thrust, and press the spacebar to fire. The reset button restarts the game. The display shows your score, lives, and current level.
