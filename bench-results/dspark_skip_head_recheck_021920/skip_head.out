I'll create a complete Space Invaders game using Pygame. This is a classic arcade game where you control a spaceship and shoot at invading aliens.

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 50
        self.height = 40
        self.vel = 5
        self.lives = 3
        self.score = 0
        
        # Create a simple spaceship shape
        self.shape = []
        for i in range(3):
            self.shape.append({
                "x": self.x + 25,
                "y": self.y + 10 * i,
            })
    
    def move_left(self):
        self.x -= self.vel
        if self.x < 0:
            self.x = 0
    
    def move_right(self):
        self.x += self.vel
        if self.x > SCREEN_WIDTH - self.width:
            self.x = SCREEN_WIDTH - self.width
    
    def draw(self, screen):
        # Draw spaceship (triangle shape)
        points = [
            (self.x + self.width // 2, self.y),  # Top point
            (self.x, self.y + self.height),  # Bottom left
            (self.x + self.width, self.y + self.height)  # Bottom right
        ]
        pygame.draw.polygon(screen, GREEN, points)
        
        # Draw cockpit
        cockpit_x = self.x + self.width // 2 - 10
        cockpit_y = self.y + 15
        pygame.draw.circle(screen, BLUE, (cockpit_x, cockpit_y), 8)
    
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height
