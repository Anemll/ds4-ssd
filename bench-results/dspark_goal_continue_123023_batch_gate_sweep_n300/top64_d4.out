    def __init__(self):
        self.x = SCREEN_WIDTH // 2
        self.y = SCREEN_HEIGHT - 50
        self.width = 40
        self.height = 40
        self.speed = 5
        self.rect = pygame.Rect(self.x - self.width//2, self.y - self.height//2, self.width, self.height)
        self.lives = 3
        self.score = 0
        
    def update(self):
        self.rect.center = (self.x, self.y)
        
