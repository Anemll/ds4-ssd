Here's a complete Space Invaders game in Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self):
        self.width = 60
        self.height = 20
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        # Draw triangle on top
        pygame.draw.polygon(screen, GREEN, 
            (self.x + self.width//2, self.y - 10),
            (self.x, self.y),
            (self.x + self.width, self.y))

class Enemy:
    def __init__(self, x, y):
        self.width = 40
        self.height = 30
        self.x = x
        self.y = y
        self.speed = 1
        self.direction = 1  # 1 for right, -1 for left
        
    def update(self):
        self.x += self.speed * self.direction
    
    def draw(self, screen):
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        # Draw spikes
        for i in range(3):
            spike_x = self.x + 10 * i + 5
            spike_y = self.y + self.height
            pygame.draw.line(screen, RED, 
                (spike_x, self.y + self.height),
                (spike_x + 5, self.y + self.height + 10),
                2)

class Bullet:
    def __init__(self, x, y, speed=5):
        self.x = x
        self.y = y
        self.speed = speed
        self.width = 4
        self.height = 10
        
    def update(self):
        self.y += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, WHITE, (self.x, self.y, self.width, self.height))

class EnemyBullet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.speed = 3
        self.width = 4
        self.height = 10
        
    def update(self):
        self.y += self.speed
    
    def draw(self, screen):
        pygame.draw.rect(screen, YELLOW, (self.x, self.y, self.width, self.height))

def create_enemies():
    enemies = []
    for row in range(3):
        for col in range(8):
            x = col * 80 + 50
            y = row * 60 + 50
            enemies.append(Enemy(x, y))
    return enemies

def main():
    screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    pygame.display.set_caption("Space Invaders")
    clock = pygame.time.Clock()
    
    # Game objects
    player = Player()
    bullets = []
    enemy_bullets = []
    enemies = create_enemies()
    
    # Game state
    running = True
    game_over = False
    score = 0
    lives = 3
    
    # Shooting
    bullet_cooldown = 0
    enemy_shoot_timer = 0
    
    while running:
        # Event handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE and not game_over and bullet_cooldown == 0:
                    bullets.append(Bullet(player.x + player.width//2 - 2, player.y))
                    bullet_cooldown = 10
