            self.boss.move(1, 0)
        else:
                       self.boss.move_to(self, self.boss)
        else:
            self.boss.move(-1, 0)
        self.move_boss()
    def move_enemies(self):
        # Move enemies
        if self.enemy_direction:
            for enemy in self.enemies:
                enemy.move(1, 0)
        else:
            for enemy in self.enemies:
                enemy.move(-1, 0)
        self.move_enemies()
