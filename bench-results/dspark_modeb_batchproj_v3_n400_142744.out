I'll create a complete Space Invaders game using Pygame. This will include a player ship, enemies, bullets, and scoring.

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
PLAYER_SPEED = 5
BULLET_SPEED = 7
ENEMY_SPEED = 1
ENEMY_BULLET_SPEED = 3

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
YELLOW = (255, 255, 0)

class Player:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 40
        self.height = 30
        self.speed = 5
        self.lives = 3
        self.score = 0
        
    def draw(self, screen):
        # Draw player ship (triangle)
        points = [
            (self.x, self.y - 15),  # Top
            (self.x - 20, self.y + 15),  # Bottom left
            (self.x + 20, self.y + 15)   # Bottom right
        ]
        pygame.draw.polygon(screen, WHITE, points)
        
    def move_left(self):
        self.x -= self.speed
        if self.x < 20:
            self.x = 20
            
    def move_right(self):
        self.x += self.speed
        if self.x > SCREEN_WIDTH - 20:
            self.x = SCREEN_WIDTH - 20
