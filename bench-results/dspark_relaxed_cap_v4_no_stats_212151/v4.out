Here's a complete Space Invaders game using Pygame:

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
YELLOW = (255, 255, 0)

# Set up the display
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Space Invaders")
clock = pygame.time.Clock()

class Player:
    def __init__(self):
        self.width = 60
        self.height = 20
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = 5
        self.bullets = []
        self.lives = 3
        self.score = 0
        
    def update(self, keys):
        if keys[pygame.K_LEFT] and self.x > 0:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] and self.x < SCREEN_WIDTH - self.width:
            self.x += self.speed
            
    def draw(self):
        pygame.draw.rect(screen, GREEN, (self.x, self.y, self.width, self.height))
        pygame.draw.polygon(screen, WHITE, [
            (self.x + 20, self.y - 10),
            (self.x + 30, self.y - 20),
            (self.x + 40, self.y - 10)
        ])
        
    def shoot(self):
        if len(self.bullets) < 5:  # Limit bullets
            self.bullets.append({
                'x': self.x + self.width // 2 - 2,
                'y': self.y - 10,
                'speed': 10
            })

class Enemy:
    def __init__(self, x, y):
        self.width = 40
        self.height = 30
        self.x = x
        self.y = y
        self.speed = 2
        self.direction = 1  # 1 for right, -1 for left
        self.bullets = []
        
    def update(self):
        self.x += self.speed * self.direction
        
        # Randomly shoot
        if random.random() < 0.02:  # 2% chance per frame
            self.bullets.append({
                'x': self.x + self.width // 2 - 2,
                'y': self.y,
                'speed': 5
            })
        
    def draw(self):
        # Draw enemy (simple shape)
        pygame.draw.rect(screen, RED, (self.x, self.y, self.width, self.height))
        pygame.draw.polygon(screen, WHITE, [
            (self.x + 10, self.y),
            (self.x + 20, self.y - 15),
            (self.x + 30, self.y)
        ])

class Bullet:
    def __init__(self, x, y, speed):
        self.x = x
        self.y = y
        self.speed = speed
        
    def update(self):
        if self.speed > 0:  # Player bullet
            self.y -= self.speed
        else:  # Enemy bullet
            self.y += self.speed
        
    def draw(self):
        pygame.draw.rect(screen, YELLOW, (self.x, self.y, 4, 10))

def main():
    game = True
    game_over = False
    player = Player()
    enemies = []
    bullets = []
    
    # Create enemies
    for row in range(3):
        for col in range(10):
            x = col * 60 + 50
            y = row * 50 + 50
            enemies.append(Enemy(x, y))
    
    while game:
        # Event handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                game = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE and not game_over:
                    player.shoot()
        
        # Clear screen
        screen.fill(BLACK)
        
        if not game_over:
            # Get keys
            keys = pygame.key.get_pressed()
            
            # Update player
            player.update(keys)
            
