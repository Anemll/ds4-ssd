        self.x = x
        self.y = y
        self.width = 100
        self.height = 100
        self.speed = 0
        self.rect = pygame.Rect(x, y, self.width, self.height)

class Bullet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 10
        self.height = 10
        self.speed = 0
        self.rect = pygame.Rect(x, y, self.width, self.height)

class Game:
    def __init__(self):
        self.player = pygame
        self.enemies = []
        self.bullets = []
        self.score = 0
        self.lives = 3
        self.game_over = False
        self.win = True

    def update(self):
        self.player = pygame
        self.player.x = self.player
        self.player.y = self.player
        self.player.rect = self.player.x, self.player.y
