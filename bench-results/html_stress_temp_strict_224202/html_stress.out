I'll create a pixel-perfect Space Invaders arcade game in a single HTML file, replicating the original 1978 Taito experience with authentic sprites, mechanics, and rules.
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Space Invaders · 1978 Taito</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            image-rendering: pixelated;
        }

        .cabinet {
            background: #111;
            border: 4px solid #333;
            border-radius: 12px;
            padding: 20px 30px;
            box-shadow: 0 0 30px rgba(0, 200, 0, 0.2);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .screen-wrapper {
            background: #0a0a0a;
            border: 6px solid #222;
            border-radius: 8px;
            padding: 10px;
            display: inline-block;
        }

        canvas {
            display: block;
            background: #0f0f0f;
            width: 640px;
            height: 640px;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
            box-shadow: inset 0 0 20px #000;
        }

        .info-panel {
            display: flex;
            justify-content: space-between;
            width: 100%;
            margin-top: 16px;
            color: #7fdf7f;
            font-size: 22px;
            font-weight: bold;
            text-shadow: 0 0 6px #0f0;
            letter-spacing: 2px;
            background: #1a1a1a;
            padding: 10px 20px;
            border-radius: 6px;
            border: 2px solid #2a2a2a;
        }

        .info-panel span {
            background: #000;
            padding: 4px 12px;
            border-radius: 4px;
            border: 1px solid #3f3f3f;
        }

        .controls {
            display: flex;
            gap: 30px;
            margin-top: 18px;
            color: #aaa;
            font-size: 15px;
            background: #0c0c0c;
            padding: 10px 28px;
            border-radius: 20px;
            border: 2px solid #2e2e2e;
            letter-spacing: 1px;
        }

        .controls kbd {
            background: #222;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid #555;
            color: #cfcfcf;
            font-weight: bold;
        }

        .btn-reset {
            background: #1c1c1c;
            border: 2px solid #3a3a3a;
            color: #b0b0b0;
            font-size: 18px;
            padding: 6px 18px;
            border-radius: 20px;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            margin-top: 8px;
            transition: 0.2s;
        }
        .btn-reset:hover {
            background: #2a2a2a;
            border-color: #5f5f5f;
            color: #fff;
        }

        /* pixel-perfect invaders style */
        @media (max-width: 720px) {
            canvas { width: 360px; height: 360px; }
            .info-panel { font-size: 16px; }
        }
    </style>
</head>
<body>
<div class="cabinet">
    <div class="screen-wrapper">
        <canvas id="gameCanvas" width="640" height="640"></canvas>
    </div>
    <div class="info-panel">
        <span>🏆 <span id="scoreDisplay">000</span></span>
        <span>💀 <span id="livesDisplay">3</span></span>
    </div>
    <div class="controls">
        <span><kbd>←</kbd> <kbd>→</kbd> move</span>
        <span><kbd>SPACE</kbd> fire</span>
        <span><kbd>R</kbd> restart</span>
    </div>
    <button class="btn-reset" id="resetBtn">⟳ RESTART</button>
</div>

<script>
    (function() {
        // ---------- 1978 Taito Space Invaders ----------
        // pixel-perfect faithful reproduction

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreSpan = document.getElementById('scoreDisplay');
        const livesSpan = document document.getElementById('livesDisplay');

        // ----- GAME CONFIG -----
        const INVADER_ROWS = 5;
        const INVADERS_PER_ROW = 11;
        const INVADER_WIDTH = 28;
        const INVADER_HEIGHT = 24;
        const PLAYER_WIDTH = 28;
        const PLAYER_HEIGHT = 16;
        const LASER_WIDTH = 4;
        const LASER_HEIGHT = 12;
        const BOMB_WIDTH = 6;
        const BOMB_HEIGHT = 10;

        // scaling
        const SCALE = 1.0;

        // positions (grid)
        const GRID_LEFT = 40;
        const GRID_TOP = 40;
        const GRID_RIGHT = 600;
        const GRID_BOTTOM = 400;

        // player
        const PLAYER_Y = 580;

        // ----- GAME STATE -----
        let score = 0;
        let lives = 3;
        let gameOver = false;
        let win = false;
        let frame = 0;

        // invaders array
        let invaders = [];
        let invaderDirection = 1; // 1 = right, -1 = left
        let invaderSpeed = 1.2;
        let moveDownCounter = 0;
        const MOVE_DOWN_FRAMES = 18;

        // player
        let playerX = 300;
        let playerLaser = null; // { x, y, active }

        // bombs
        let bombs = [];
        const BOMB_RATE = 0.6; // per frame probability

        // invaders shot
        let invaderLaserActive = false;

        // animation
        let invaderStep = 0; // 0 or 1 for leg animation

        // ----- HELPER: pixel sprite drawing (authentic 1978) -----
        function drawInvader(x, y, step, type) {
            // type 0 = top two rows (square), type 1 = middle, type 2 = bottom (1 row)
            // but we use classic 15x12 pixel art
            const s = 2; // pixel size
            const ox = x, oy = y;
            // draw using rects for crisp pixels
            ctx.fillStyle = '#3fdf3f';
            // common shape (simplified but faithful)
            // head
            ctx.fillRect(ox + 4*s, oy + 2*s, 4*s, 2*s);
            ctx.fillRect(ox + 6*s, oy + 0*s, 2*s, 2*s);
            // body
            ctx.fillRect(ox + 2*s, oy + 4*s, 8*s, 2*s);
            // legs (animated)
            if (step === 0) {
                ctx.fillRect(ox + 2*s, oy + 6*s, 2*s, 2*s);
                ctx.fillRect(ox + 8*s, oy + 6*s, 2*s, 2*s);
            } else {
                ctx.fillRect(ox + 4*s, oy + 6*s, 2*s, 2*s);
                ctx.fillRect(ox + 6*s, oy + 6*s, 2*s, 2*s);
            }
            // eyes
            ctx.fillStyle = '#000';
            ctx.fillRect(ox + 4*s, oy + 2*s, 2*s, 2*s);
            ctx.fillRect(ox + 8*s, oy + 2*s, 2*s, 2*s);
            // antenna
            ctx.fillStyle = '#3fdf3f';
            ctx.fillRect(ox + 6*s, oy + 0*s, 2*s, 1*s);
        }

        function drawPlayer(x, y) {
            const s = 2;
            ctx.fillStyle = '#7fff7f';
            // base
            ctx.fillRect(x + 2*s, y + 4*s, 10*s, 2*s);
            // turret
            ctx.fillRect(x + 4*s, y + 0*s, 6*s, 4*s);
            // cannon
            ctx.fillRect(x + 6*s, y - 2*s, 2*s, 2*s);
            // details
            ctx.fillStyle = '#000';
            ctx.fillRect(x + 4*s, y + 2*s, 2*s, 2*s);
            ctx.fillRect(x + 8*s, y + 2*s, 2*s, 2*s);
        }

        // ----- INIT -----
        function initGame() {
            invaders = [];
            for (let row = 0; row < INVADER_ROWS; row++) {
                for (let col = 0; col < INVADERS_PER_ROW; col++) {
                    invaders.push({
                        x: GRID_LEFT + col * (INVADER_WIDTH + 12),
                        y: GRID_TOP + row * (INVADER_HEIGHT + 10),
                        active: true,
                        type: row < 2 ? 0 : (row < 4 ? 1 : 2)
                    });
                }
            }
            playerX = 300;
            playerLaser = null;
            bombs = [];
            score = 0;
            lives = 3;
            gameOver = false;
            win = false;
            invaderDirection = 1;
            invaderSpeed = 1.2;
            moveDownCounter = 0;
            updateUI();
        }

        // ----- UPDATE -----
        function update() {
            if (gameOver || win) return;

            frame++;

            // ---- INVADER MOVEMENT ----
            let moveDown = false;
            let edgeReach = false;

            // check if any invader reaches edge
            let leftMost = 999, rightMost = -999;
            for (let inv of invaders) {
                if (!inv.active) continue;
                if (inv.x < leftMost) leftMost = inv.x;
                if (inv.x > rightMost) rightMost = inv.x;
            }
            if (rightMost > 580) {
                invaderDirection = -1;
                edgeReach = true;
            } else if (leftMost < 20) {
                invaderDirection = 1;
                edgeReach = true;
            }

            if (edgeReach) {
                moveDownCounter = 0;
                // move down all invaders
                for (let inv of invaders) {
                    if (inv.active) inv.y += 10;
                }
                // also shift down
                moveDown = true;
            }

            // move horizontally
            for (let inv of invaders) {
                if (inv.active) {
                    inv.x += invaderDirection * invaderSpeed;
                }
            }

            // move down periodically (every MOVE_DOWN_FRAMES)
            if (!edgeReach) {
                moveDownCounter++;
                if (moveDownCounter >= MOVE_DOWN_FRAMES) {
                    moveDownCounter = 0;
                    for (let inv of invaders) {
                        if (inv.active) inv.y += 6;
                    }
                }
            }

            // ---- INVADER ANIMATION ----
            invaderStep = (invaderStep + 1) % 2;

            // ---- BOMBS ----
            // random bombs from active invaders
            if (Math.random() < 0.04) {
                let activeInvaders = invaders.filter(i => i.active);
                if (activeInvaders.length > 0) {
                    let src = activeInvaders[Math.floor(Math.random() * activeInvaders.length)];
                    bombs.push({
                        x: src.x + INVADER_WIDTH/2 - 3,
                        y: src.y + INVADER_HEIGHT,
                        active: true
                    });
                }
            }

            // move bombs
            for (let b of bombs) {
                if (b.active) {
                    b.y += 4;
                    if (b.y > 640) b.active = false;
                }
            }

            // ---- PLAYER LASER ----
            if (playerLaser && playerLaser.active) {
                playerLaser.y -= 8;
                if (playerLaser.y < 0) playerLaser.active = false;
            }

            // ---- COLLISIONS ----
            // laser vs invaders
            if (playerLaser && playerLaser.active) {
                for (let inv of invaders) {
                    if (!inv.active) continue;
                    // simple AABB
                    if (playerLaser.x > inv.x && playerLaser.x < inv.x + INVADER_WIDTH &&
                        playerLaser.y > inv.y && playerLaser.y < inv.y + INVADER_HEIGHT) {
                        inv.active = false;
                        playerLaser.active = false;
                        score += 10;
                        updateUI();
                        break;
                    }
                }
            }

            // bombs vs player
            for (let b of bombs) {
                if (!b.active) continue;
                if (b.x > playerX && b.x < playerX + PLAYER_WIDTH &&
                    b.y > PLAYER_Y && b.y < PLAYER_Y + PLAYER_HEIGHT) {
                    b.active = false;
                    lives--;
                    updateUI();
                    if (lives <= 0) {
                        gameOver = true;
                    }
                    // reset position? original: player respawns
                    playerX = 300;
                    playerLaser = null;
                }
            }

            // invader vs player (if invader reaches bottom)
            for (let inv of invaders) {
                if (!inv.active) continue;
                if (inv.y + INVADER_HEIGHT >= PLAYER_Y) {
                    gameOver = true;
                }
            }

            // check win
            if (invaders.every(i => !i.active)) {
                win = true;
            }

            // cleanup
            bombs = bombs.filter(b => b.active);
        }

        // ----- RENDER -----
        function draw() {
            ctx.clearRect(0, 0, 640, 640);

            // background grid (authentic dark)
            ctx.fillStyle = '#0a0a0a';
            ctx.fillRect(0, 0, 640, 640);

            // draw invaders
            for (let inv of invaders) {
                if (!inv.active) continue;
                drawInvader(inv.x, inv.y, invaderStep, inv.type);
            }

            // draw player
            if (!gameOver && !win) {
                drawPlayer(playerX, PLAYER_Y);
            }

            // draw laser
            if (playerLaser && playerLaser.active) {
                ctx.fillStyle = '#fff';
                ctx.shadowColor = '#0f0';
                ctx.shadowBlur = 12;
                ctx.fillRect(playerLaser.x, playerLaser.y, LASER_WIDTH, LASER_HEIGHT);
                ctx.shadowBlur = 0;
            }

            // draw bombs
            ctx.fillStyle = '#ff3f3f';
            ctx.shadowColor = '#f00';
            ctx.shadowBlur = 10;
            for (let b of bombs) {
                if (b.active) {
                    ctx.fillRect(b.x, b.y, BOMB_WIDTH, BOMB_HEIGHT);
                }
            }
            ctx.shadowBlur = 0;

            // game over / win overlay
            if (gameOver) {
                ctx.fillStyle = '#000';
                ctx.globalAlpha = 0.7;
                ctx.fillRect(0, 240, 640, 80);
                ctx.globalAlpha = 1;
                ctx.fillStyle = '#ff3f3f';
                ctx.font = 'bold 36px "Courier New", monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('GAME OVER', 320, 280);
            }
            if (win) {
                ctx.fillStyle = '#000';
                ctx.globalAlpha = 0.6;
                ctx.fillRect(0, 240, 640, 80);
                ctx.globalAlpha = 1;
                ctx.fillStyle = '#7fff7f';
                ctx.font = 'bold 36px "Courier New", monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('YOU WIN!', 320, 280);
            }

            // score display (already updated)
        }

        // ----- UI update -----
        function updateUI() {
            scoreSpan.textContent = String(score).padStart(3, '0');
            livesSpan.textContent = lives;
        }

        // ----- INPUT -----
        const keys = { left: false, right: false, space: false };

        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') { keys.left = true; e.preventDefault(); }
            if (e.key === 'ArrowRight') { keys.right = true; e.preventDefault(); }
            if (e.key === '
