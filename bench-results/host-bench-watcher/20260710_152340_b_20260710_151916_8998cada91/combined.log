<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Asteroids · Arcade</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0a0a0a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    .game-wrapper {
      background: #111;
      border: 2px solid #33ff33;
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 0 30px #1f1f1f;
    }
    canvas {
      display: block;
      background: #0a0a0a;
      width: 800px;
      height: 600px;
      border: 1px solid #33ff33;
      cursor: none;
    }
    .info-panel {
      display: flex;
      justify-content: space-between;
      color: #33ff33;
      font-size: 1.2rem;
      font-weight: bold;
      padding: 8px 12px;
      background: #0c0c0c;
      border-bottom: 1px solid #33ff33;
      letter-spacing: 2px;
    }
    .info-panel span {
      text-shadow: 0 0 6px #33ff33;
    }
    .controls {
      display: flex;
      gap: 20px;
      color: #33ff33;
      font-size: 0.85rem;
      padding: 6px 12px;
      background: #0c0c0c;
      border-top: 1px solid #33ff33;
      justify-content: center;
    }
    .controls kbd {
      background: #222;
      border: 1px solid #33ff33;
      padding: 2px 8px;
      border-radius: 4px;
      color: #afffaf;
    }
  </style>
</head>
<body>
<div class="game-wrapper">
  <div class="info-panel">
    <span>�� SCORE: <span id="scoreDisplay">0</span></span>
    <span>❤️ LIVES: <span id="livesDisplay">3</span></span>
  </div>
  <canvas id="gameCanvas" width="800" height="600"></canvas>
  <div class="controls">
    <span><kbd>←</kbd> <kbd>→</kbd> rotate</span>
    <span><kbd>↑</kbd> thrust</span>
    <span><kbd>���</kbd> fire</span>
    <span><kbd>R</kbd> restart</span>
  </div>
</div>
<script>
  (function() {
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const livesSpan = document.getElementById('livesDisplay');

    // ---------- CONSTANTS ----------
    const W = 800, H = 600;
    const MAX_ROCK_SPEED = 3.5;
    const MAX_ROCK_SIZE = 40;
    const MIN_ROCK_SIZE = 12;
    const PLAYER_RADIUS = 14;
    const PARTICLE_COUNT = 18;

    // ---------- GAME STATE ----------
    let score = 0;
    let lives = 3;
    let gameOver = false;
    let restartFlag = false;

    // ---------- ENTITIES ----------
    let player = {
      x: W/2, y: H/2,
      angle: -Math.PI/2,   // up
      vx: 0, vy: 0,
      radius: PLAYER_RADIUS,
      active: true,
      invincible: false,   // brief immunity after respawn
      invTimer: 0
    };

    let bullets = [];
    let rocks = [];
    let particles = [];

    // ---------- INPUT ----------
    const keys = {
      left: false, right: false, up: false, space: false
    };
    let spacePressed = false;
    let fireCooldown = 0;

    // ---------- HELPERS ----------
    function wrap(entity) {
      if (entity.x < 0) entity.x = W;
      else if (entity.x > W) entity.x = 0;
      if (entity.y < 0) entity.y = H;
      else if (entity.y > H) entity.y = 0;
    }

    function dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }

    function randomAngle() { return Math.random() * 2 * Math.PI; }

    // ---------- INIT / RESET ----------
    function resetGame() {
      score = 0;
      lives = 3;
      gameOver = false;
      restartFlag = false;
      updateUI();

      // reset player
      player.x = W/2;
      player.y = H/2;
      player.angle = -Math.PI/2;
      player.vx = 0;
      player.vy = 0;
      player.active = true;
      player.invincible = true;
      player.invTimer = 60;  // 1 second at 60fps

      bullets = [];
      particles = [];

      // spawn initial rocks
      rocks = [];
      for (let i = 0; i < 4; i++) {
        spawnRock(true);
      }
    }

    // ---------- ROCK SPAWNING ----------
    function spawnRock(initial = false) {
      let x, y, angle, speed, size;
      const safeDist = 80;
      let attempts = 0;
      do {
        if (initial) {
          // spawn from edges
          const side = Math.floor(Math.random() * 4);
          if (side === 0) { x = 0; y = Math.random() * H; }
          else if (side === 1) { x = W; y = Math.random() * H; }
          else if (side === 2) { x = Math.random() * W; y = 0; }
          else { x = Math.random() * W; y = H; }
        } else {
          // spawn from random position, but not near player
          x = Math.random() * W;
          y = Math.random() * H;
        }
        attempts++;
      } while (initial && dist({x, y}, player) < safeDist && attempts < 50);

      angle = randomAngle();
      speed = 0.5 + Math.random() * 2.5;
      size = MAX_ROCK_SIZE;

      rocks.push({
        x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
        size: size,
        radius: size/2,
        rotation: Math.random() * 2 * Math.PI,
        rotSpeed: (Math.random() - 0.5) * 0.04
      });
    }

    // ---------- SPLIT ROCK ----------
    function splitRock(rock, bullet) {
      // reduce score for small rocks? Actually classic: small rock = more points
      const size = rock.size;
      let points = 0;
      if (size > 30) points = 20;
      else if (size > 20) points = 50;
      else points = 100;
      score += points;
      updateUI();

      // create two smaller rocks if size > MIN_ROCK_SIZE
      if (size > MIN_ROCK_SIZE) {
        const newSize = size * 0.6;
        const speed = Math.hypot(rock.vx, rock.vy) * 1.2;
        for (let i = 0; i < 2; i++) {
          const angle = randomAngle();
          const vx = Math.cos(angle) * speed * 0.8;
          const vy = Math.sin(angle) * speed * 0.8;
          rocks.push({
            x: rock.x + (Math.random() - 0.5) * 10,
            y: rock.y + (Math.random() - 0.5) * 10,
            vx: rock.vx * 0.5 + vx,
            vy: rock.vy * 0.5 + vy,
            size: newSize,
            radius: newSize/2,
            rotation: Math.random() * 2 * Math.PI,
            rotSpeed: (Math.random() - 0.5) * 0.06
          });
        }
      }
      // remove rock
      const idx = rocks.indexOf(rock);
      if (idx > -1) rocks.splice(idx, 1);

      // particle explosion
      createExplosion(rock.x, rock.y, rock.size);
    }

    // ---------- PARTICLES ----------
    function createExplosion(x, y, size) {
      const count = Math.floor(size * 0.6) + 6;
      for (let i = 0; i < count; i++) {
        const angle = randomAngle();
        const speed = 0.5 + Math.random() * 3.5;
        particles.push({
          x, y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 30 + Math.random() * 20,
          maxLife: 50,
          size: 2 + Math.random() * 4,
          color: Math.random() > 0.5 ? '#33ff33' : '#88ff88'
        });
      }
    }

    // ---------- COLLISION DETECTION ----------
    function handleCollisions() {
      // bullets vs rocks
      for (let b = bullets.length - 1; b >= 0; b--) {
        const bullet = bullets[b];
        for (let r = rocks.length - 1; r >= 0; r--) {
          const rock = rocks[r];
          if (dist(bullet, rock) < rock.radius + 3) {
            // split rock
            splitRock(rock, bullet);
            // remove bullet
            bullets.splice(b, 1);
            break;
          }
        }
      }

      // player vs rocks (if active and not invincible)
      if (player.active && !player.invincible) {
        for (let r = rocks.length - 1; r >= 0; r--) {
          const rock = rocks[r];
          if (dist(player, rock) < player.radius + rock.radius) {
            // player hit
            lives--;
            updateUI();
            createExplosion(player.x, player.y, 30);
            if (lives <= 0) {
              gameOver = true;
              player.active = false;
              return;
            }
            // respawn
            player.x = W/2;
            player.y = H/2;
            player.vx = 0;
            player.vy = 0;
            player.angle = -Math.PI/2;
            player.invincible = true;
            player.invTimer = 60;
            // remove rock that hit? (classic: rock disappears)
            rocks.splice(r, 1);
            break;
          }
        }
      }
    }

    // ---------- UPDATE ----------
    function update() {
      if (gameOver) return;

      // ----- player movement -----
      if (player.active) {
        // rotation
        if (keys.left) player.angle -= 0.06;
        if (keys.right) player.angle += 0.06;

        // thrust
        if (keys.up) {
          const thrust = 0.15;
          player.vx += Math.cos(player.angle) * thrust;
          player.vy += Math.sin(player.angle) * thrust;
          // thrust particles
          if (Math.random() > 0.5) {
            particles.push({
              x: player.x - Math.cos(player.angle) * 16,
              y: player.y - Math.sin(player.angle) * 16,
              vx: player.vx * 0.5 + (Math.random() - 0.5) * 0.5,
              vy: player.vy * 0.5 + (Math.random() - 0.5) * 0.5,
              life: 12, maxLife: 20, size: 2,
              color: '#88ff88'
            });
          }
        }

        // friction
        player.vx *= 0.98;
        player.vy *= 0.98;
        // speed cap
        const maxSpeed = 6;
        let sp = Math.hypot(player.vx, player.vy);
        if (sp > maxSpeed) {
          player.vx = (player.vx / sp) * maxSpeed;
          player.vy = (player.vy / sp) * maxSpeed;
        }

        player.x += player.vx;
        player.y += player.vy;
        wrap(player);

        // invincibility timer
        if (player.invincible) {
          player.invTimer--;
          if (player.invTimer <= 0) player.invincible = false;
        }
      }

      // ----- fire bullet -----
      if (keys.space && fireCooldown <= 0 && player.active && !gameOver) {
        const bx = player.x + Math.cos(player.angle) * 20;
        const by = player.y + Math.sin(player.angle) * 20;
        bullets.push({
          x: bx, y: by,
          vx: player.vx + Math.cos(player.angle) * 7,
          vy: player.vy + Math.sin(player.angle) * 7,
          life: 40
        });
        fireCooldown = 10;
      }
      if (fireCooldown > 0) fireCooldown--;

      // ----- update bullets -----
      for (let i = bullets.length - 1; i >= 0; i--) {
        const b = bullets[i];
        b.x += b.vx;
        b.y += b.vy;
        b.life--;
        wrap(b);
        if (b.life <= 0) {
          bullets.splice(i, 1);
        }
      }

      // ----- update rocks -----
      for (let r of rocks) {
        r.x += r.vx;
        r.y += r.vy;
        r.rotation += r.rotSpeed;
        wrap(r);
        // speed limit
        let sp = Math.hypot(r.vx, r.vy);
        if (sp > MAX_ROCK_SPEED) {
          r.vx = (r.vx / sp) * MAX_ROCK_SPEED;
          r.vy = (r.vy / sp) * MAX_ROCK_SPEED;
        }
      }

      // ----- update particles -----
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.96;
        p.vy *= 0.96;
        p.life--;
        if (p.life <= 0) {
          particles.splice(i, 1);
        }
      }

      // ----- collisions -----
      handleCollisions();

      // ----- ensure at least 3 rocks -----
      if (rocks.length < 3 && !gameOver) {
        spawnRock(false);
      }
    }

    // ---------- DRAW ----------
    function draw() {
      ctx.clearRect(0, 0, W, H);

      // background grid (vector vibe)
      ctx.strokeStyle = '#1a1a1a';
      ctx.lineWidth = 0.5;
      for (let i = 0; i < W; i += 40) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, H);
        ctx.stroke();
      }
      for (let i = 0; i < H; i += 40) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(W, i);
        ctx.stroke();
      }

      // ----- draw rocks (vector style) -----
      for (let r of rocks) {
        const s = r.size;
        const points = 8 + Math.floor(s / 8);
        const step = 2 * Math.PI / points;
        const offset = r.rotation;
        ctx.strokeStyle = '#33ff33';
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (let i = 0; i < points; i++) {
          const ang = i * step + offset;
          const rad = s * 0.5 * (0.7 + 0.3 * Math.sin(i * 3.7));
          const x = r.x + Math.cos(ang) * rad;
          const y = r.y + Math.sin(ang) * rad;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.stroke();
        // inner glow
        ctx.fillStyle = '#1a1a1a';
        ctx.fill();
      }

      // ----- draw bullets (bright green dots) -----
      for (let b of bullets) {
        ctx.fillStyle = '#afffaf';
        ctx.shadowColor = '#33ff33';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(b.x, b.y, 3, 0, 2 * Math.PI);
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // ----- draw player (vector ship) -----
      if (player.active) {
        const px = player.x, py = player.y, ang = player.angle;
        const len = 20;
        // invincibility blink
        if (player.invincible && (player.invTimer % 10 < 5)) {
          ctx.strokeStyle = '#88ff88';
        } else {
          ctx.strokeStyle = '#33ff33';
        }
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        // nose
        ctx.moveTo(px + Math.cos(ang) * len, py + Math.sin(ang) * len);
        // left wing
        ctx.lineTo(px + Math.cos(ang + 2.2) * len * 0.7, py + Math.sin(ang + 2.2) * len * 0.7);
        // rear left
        ctx.lineTo(px + Math.cos(ang + 2.8) * len * 0.5, py + Math.sin(ang + 2.8) * len * 0.5);
        // rear right
        ctx.lineTo(px + Math.cos(ang - 2.8) * len * 0.5, py + Math.sin(ang - 2.8) * len * 0.5);
        // right wing
        ctx.lineTo(px + Math.cos(ang - 2.2) * len * 0.7, py + Math.sin(ang - 2.2) * len * 0.7);
        ctx.closePath();
        ctx.stroke();
        // cockpit dot
        ctx.fillStyle = '#afffaf';
        ctx.beginPath();
        ctx.arc(px + Math.cos(ang) * 6, py + Math.sin(ang) * 6, 2, 0, 2 * Math.PI);
        ctx.fill();
      }

      // ----- draw particles (green sparks) -----
      for (let p of particles) {
        const alpha = p.life / p.maxLife;
        ctx.fillStyle = p.color;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * alpha, 0, 2 * Math.PI);
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      // ----- game over overlay -----
      if (gameOver) {
        ctx.fillStyle = '#33ff33';
        ctx.font = 'bold 42px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = '#33ff33';
        ctx.shadowBlur = 20;
        ctx.fillText('GAME OVER', W/2, H/2 - 20);
        ctx.font = '20px "Courier New", monospace';
        ctx.fillText('press R to restart', W/2, H/2 + 40);
        ctx.shadowBlur = 0;
      }
    }

    // ---------- UI UPDATE ----------
    function updateUI() {
      scoreSpan.textContent = score;
      livesSpan.textContent = lives;
    }

    // ---------- KEYBOARD ----------
    document.addEventListener('keydown', (e) => {
      const key = e.key;
      if (key === 'ArrowLeft') keys.left = true;
      else if (key === 'ArrowRight') keys.right = true;
      else if (key === 'ArrowUp') keys.up = true;
      else if (key === ' ') { keys.space = true; e.preventDefault(); }
      else if (key === 'r' || key === 'R') {
        resetGame();
        e.preventDefault();
      }
    });
    document.addEventListener('keyup', (e) => {
      const key = e.key;
      if (key === 'ArrowLeft') keys.left = false;
      else if (key === 'ArrowRight') keys.right = false;
      else if (key === 'ArrowUp') keys.up = false;
      else if (key === ' ') { keys.space = false; e.preventDefault(); }
    });

    // ---------- GAME LOOP ----------
    function gameLoop() {
      update();
      draw();
      requestAnimationFrame(gameLoop);
    }

    // ---------- START ----------
    resetGame();
    gameLoop();
  })();
</script>
</body>
</html>
```
```
### Gameplay & Mechanics
This page recreates the classic arcade feel with a focus on smooth physics and responsive controls.

- **Core Mechanics**: The game features friction-based movement, screen wrapping, and asteroid splitting. You control a green vector-style ship, firing bullets to destroy asteroids. Each asteroid splits into smaller pieces until it's destroyed, with points awarded based on size.
- **Controls & Feedback**: Use the arrow keys to rotate and thrust, the spacebar to fire, and 'R' to restart. The UI displays your score and remaining lives. Particle explosions and a blinking invincibility effect provide clear visual feedback for hits and respawns.
- **Visual Style**: The game uses a green vector-style aesthetic with a dark background grid, glowing bullets, and particle effects. The ship and asteroids are drawn with clean lines, and explosions create a burst of green sparks.

---

**Instructions:**  
1. Open the file in a web browser. The game starts immediately with 3 lives and 4 initial asteroids.  
2. Use **←/→** to rotate, **↑** to thrust, and **Space** to fire. Press **R** to reset the game at any time.  
3. Avoid asteroids and shoot them down to score points. Each life lost resets your position with temporary invincibility.
