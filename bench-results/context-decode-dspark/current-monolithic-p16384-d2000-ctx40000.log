public:
    Tetris() : score(0), level(1), linesCleared(0), gameOver(false), fallSpeed(0.5f) {
        // Initialize board
        for (int y = 0; y < BOARD_HEIGHT; y++)
            for (int x = 0; x < BOARD_WIDTH; x++)
                board[y][x] = -1;  // -1 = empty

        // Seed random
        std::srand(static_cast<unsigned>(std::time(nullptr)));

        // Create first pieces
        currentType = std::rand() % 7;
        nextType = std::rand() % 7;
        spawnPiece();
        lastFall = clock();
    }

    void spawnPiece() {
        // Copy shape to current piece
        for (int y = 0; y < 4; y++)
            for (int x = 0; x < 4; x++)
                currentPiece[y][x] = SHAPES[currentType][y][x];

        currentX = BOARD_WIDTH / 2 - 2;
        currentY = 0;
        currentType = nextType;
        nextType = std::rand() % 7;

        // Check if game over
        if (!isValidPosition(currentX, currentY, currentPiece)) {
            gameOver = true;
        }
    }

    bool isValidPosition(int x, int y, int piece[4][4]) {
        for (int py = 0; py < 4; py++) {
            for (int px = 0; px < 4; px++) {
                if (piece[py][px]) {
                    int boardX = x + px;
                    int boardY = y + py;
                    if (boardX < 0 || boardX >= BOARD_WIDTH || 
                        boardY >= BOARD_HEIGHT || boardY < 0)
                        return false;
                    if (boardY >= 0 && board[boardY][boardX] != -1)
                        return false;
                }
            }
        }
        return true;
    }

    void rotatePiece() {
        int rotated[4][4];
        for (int y = 0; y < 4; y++)
            for (int x = 0; x < 4; x++)
                rotated[x][3 - y] = currentPiece[y][x];

        if (isValidPosition(currentX, currentY, rotated)) {
            for (int y = 0; y < 4; y++)
                for (int x = 0; x < 4; x++)
                    currentPiece[y][x] = rotated[y][x];
        }
    }

    void moveLeft() {
        if (isValidPosition(currentX - 1, currentY, currentPiece))
            currentX--;
    }

    void moveRight() {
        if (isValidPosition(currentX + 1, currentY, currentPiece))
            currentX++;
    }

    void moveDown() {
        if (isValidPosition(currentX, currentY + 1, currentPiece)) {
            currentY++;
        } else {
            lockPiece();
            clearLines();
            spawnPiece();
        }
    }

    void hardDrop() {
        while (isValidPosition(currentX, currentY + 1, currentPiece)) {
            currentY++;
        }
        lockPiece();
        clearLines();
        spawnPiece();
    }

    void lockPiece() {
        for (int y = 0; y < 4; y++) {
            for (int x = 0; x < 4; x++) {
                if (currentPiece[y][x]) {
                    int boardY = currentY + y;
                    int boardX = currentX + x;
                    if (boardY >= 0 && boardY < BOARD_HEIGHT && 
                        boardX >= 0 && boardX < BOARD_WIDTH) {
                        board[boardY][boardX] = currentType;
                    }
                }
            }
        }
    }

    void clearLines() {
        int cleared = 0;
        for (int y = BOARD_HEIGHT - 1; y >= 0; y--) {
            bool full = true;
            for (int x = 0; x < BOARD_WIDTH; x++) {
                if (board[y][x] == -1) {
                    full = false;
                    break;
                }
            }
            if (full) {
                cleared++;
                // Shift everything down
                for (int ny = y; ny > 0; ny--) {
                    for (int nx = 0; nx < BOARD_WIDTH; nx++) {
                        board[ny][nx] = board[ny-1][nx];
                    }
                }
                // Clear top row
                for (int nx = 0; nx < BOARD_WIDTH; nx++) {
                    board[0][nx] = -1;
                }
                y++;  // Check same row again
            }
        }

        if (cleared > 0) {
            linesCleared += cleared;
            score += cleared * 100 * level;
            // Level up every 10 lines
            level = 1 + linesCleared / 10;
            fallSpeed = 0.5f - (level - 1) * 0.05f;
            if (fallSpeed < 0.1f) fallSpeed = 0.1f;
        }
    }

