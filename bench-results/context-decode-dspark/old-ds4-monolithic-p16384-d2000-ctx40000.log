                    int boardX = pieceX + j;
                    int boardY = pieceY + i;
                    if (boardY >= 0 && boardY < BOARD_HEIGHT && boardX >= 0 && boardX < BOARD_WIDTH) {
                        board[boardY][boardX] = 1; // Mark as occupied
                    }
                }
            }
        }
        
