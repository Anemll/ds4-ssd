               score(0), level(1), linesCleared(0), fallSpeed(1.0f),
               fallTimer(0), gameOver(false), paused(false) {
        
        // Initialize random seed
        std::srand(std::time(nullptr));
        
        // Set up window
        window.setFramerateLimit(FPS);
        
        // Load font
        if (!font.loadFromFile("/System/Library/Fonts/Helvetica.ttc")) {
            std::cerr << "Could not load font!" << std::endl;
        }
        
        // Set up UI text
        setupText(scoreText, "Score: 0", 30, BOARD_WIDTH * BLOCK_SIZE + 10, 10);
        setupText(levelText, "Level: 1", 30, BOARD_WIDTH * BLOCK_SIZE + 10, 50);
        setupText(linesText, "Lines: 0", 30, BOARD_WIDTH * BLOCK_SIZE + 10, 90);
        setupText(gameOverText, "Game Over!", 50, BOARD_WIDTH * BLOCK_SIZE / 2 - 100, BOARD_HEIGHT * BLOCK_SIZE / 2 - 50);
        setupText(pauseText, "PAUSED", 40, BOARD_WIDTH * BLOCK_SIZE / 2 - 80, BOARD_HEIGHT * BLOCK_SIZE / 2 - 30);
        
        // Spawn first piece
        spawnPiece();
        generateNextPiece();
    }
    
    void setupText(sf::Text& text, const std::string& str, int size, int x, int y) {
        text.setFont(font);
        text.setString(str);
        text.setCharacterSize(size);
        text.setFillColor(sf::Color::White);
        text.setPosition(x, y);
    }
    
    void spawnPiece() {
        // Random piece selection
        int pieceIndex = std::rand() % TETROMINOS.size();
        currentPiece = TETROMINOS[pieceIndex];
        currentColor = PIECE_COLORS[pieceIndex];
        pieceX = BOARD_WIDTH / 2 - currentPiece[0].size() / 2;
        pieceY = 0;
        
        // Check if game over
        if (!isValidPosition(pieceX, pieceY, currentPiece)) {
            gameOver = true;
        }
    }
    
    void generateNextPiece() {
        int pieceIndex = std::rand() % TETROMINOS.size();
        nextPiece = TETROMINOS[pieceIndex];
        nextColor = PIECE_COLORS[pieceIndex];
    }
    
    bool isValidPosition(int x, int y, const std::vector<std::vector<int>>& piece) {
        for (int i = 0; i < piece.size(); i++) {
            for (int j = 0; j < piece[i].size(); j++) {
                if (piece[i][j] != 0) {
                    int boardX = x + j;
                    int boardY = y + i;
                    
                    // Check boundaries
                    if (boardX < 0 || boardX >= BOARD_WIDTH || boardY >= BOARD_HEIGHT) {
                        return false;
                    }
                    
                    // Check collision with placed pieces
                    if (boardY >= 0 && board[boardY][boardX] != 0) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    
    void placePiece() {
