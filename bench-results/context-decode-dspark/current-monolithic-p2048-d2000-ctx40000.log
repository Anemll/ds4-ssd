                        board[boardY][boardX] = currentPieceType + 1;
                    }
                }
            }
        }
        
        // Check for completed lines
        clearLines();
        
        // Spawn new piece
        spawnNewPiece();
    }

    void clearLines() {
        int linesRemoved = 0;
        
        for (int i = BOARD_HEIGHT - 1; i >= 0; i--) {
            bool lineComplete = true;
            for (int j = 0; j < BOARD_WIDTH; j++) {
                if (board[i][j] == 0) {
