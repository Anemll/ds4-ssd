                    for (int pj = 0; pj < currentPiece[pi].size(); pj++) {
                        if (currentPiece[pi][pj] != 0 &&
                            currentY + pi == i && 
                            currentX + pj == j) {
                            drawBlock = true;
                            cout << COLORS[currentPieceType] << "██";
                            break;
                        }
                    }
                    if (drawBlock) break;
                }
                
