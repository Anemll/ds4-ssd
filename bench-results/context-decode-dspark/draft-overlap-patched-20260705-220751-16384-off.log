                        return false;
                    }
                }
            }
        }
        return true;
    }

    void lockPiece() {
        // Place piece on board
        for (int i = 0; i < currentPiece.size(); i++) {
            for (int j = 0; j < currentPiece[i].size(); j++) {
                if (currentPiece[i][j]) {
                    int boardY = pieceY + i;
                    int boardX = pieceX + j;
                    if (boardY >= 0 && boardY < BOARD_HEIGHT && 
