        board.resize(BOARD_HEIGHT, std::vector<int>(BOARD_WIDTH, 0));
        
        // Seed random number generator
        std::srand(std::time(nullptr));
        
        // Initialize pieces
        generateNextPiece();
        spawnNewPiece();
    }

    void generateNextPiece() {
        int pieceIndex = std::rand() % TETROMINOS.size();
        nextPiece = TETROMINOS[pieceIndex];
    }

    void spawnNewPiece() {
        currentPiece = nextPiece;
        generateNextPiece();
        
        // Set initial position
        pieceX = BOARD_WIDTH / 2 - currentPiece[0].size() / 2;
        pieceY = 0;
        
        // Check if game over
        if (!isValidPosition(pieceX, pieceY)) {
            gameOver = true;
        }
    }

