    sf::RenderWindow window;
    sf::Font font;
    sf::Text scoreText;
    sf::Text levelText;
    sf::Text gameOverText;
    sf::Text pausedText;
    
    // Helper functions
    void initializeBoard() {
        board.clear();
        board.resize(BOARD_HEIGHT, std::vector<int>(BOARD_WIDTH, 0));
    }
    
    void spawnNewPiece() {
        // Move next piece to current
        currentPiece = nextPiece;
        currentPieceType = nextPieceType;
        
        // Generate new next piece
        nextPieceType = rand() % 7;
        nextPiece = SHAPES[nextPieceType];
        
        // Set starting position
        currentX = BOARD_WIDTH / 2 - currentPiece[0].size() / 2;
        currentY = 0;
        
        // Check if game over
        if (!isValidPosition(currentPiece, currentX, currentY)) {
            gameOver = true;
        }
    }
    
