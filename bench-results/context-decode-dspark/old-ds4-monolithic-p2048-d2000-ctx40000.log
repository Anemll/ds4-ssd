    {sf::Color::Yellow, sf::Color(200, 200, 0)},    // O
    {sf::Color::Magenta, sf::Color(200, 0, 200)},   // T
    {sf::Color::Green, sf::Color(0, 200, 0)},       // S
    {sf::Color::Red, sf::Color(200, 0, 0)},         // Z
    {sf::Color::Blue, sf::Color(0, 0, 200)},        // J
    {sf::Color(255, 165, 0), sf::Color(200, 130, 0)} // L
};

