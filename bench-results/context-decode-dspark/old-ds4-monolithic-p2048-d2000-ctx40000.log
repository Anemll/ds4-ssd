        // Draw next piece preview
        drawNextPiece();
        
        // Draw UI
        updateUI();
        window.draw(scoreText);
        window.draw(levelText);
        
        if (gameOver) {
            window.draw(gameOverText);
        }
        
        window.display();
    }
    
