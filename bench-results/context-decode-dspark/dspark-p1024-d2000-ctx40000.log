// Tetris.cpp - Full Tetris implementation for macOS
// Compile with: g++ -std=c++11 Tetris.cpp -o Tetris -lsfml-graphics -lsfml-window -lsfml-system

#include <SFML/Graphics.hpp>
#include <SFML/System.hpp>
#include <SFML/Window.hpp>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <string>

// Game constants
const int BOARD_WIDTH = 10;
const int BOARD_HEIGHT = 20;
const int BLOCK_SIZE = 30;
const int WINDOW_WIDTH = BOARD_WIDTH * BLOCK_SIZE + 200; // Extra space for side panel
const int WINDOW_HEIGHT = BOARD_HEIGHT * BLOCK_SIZE;

// Tetromino shapes (4x4 matrices)
// Each shape is represented by a 4x4 boolean matrix
struct Tetromino {
    std::vector<std::vector<bool>> shape;
    int rotation; // Current rotation state (0-3)
    sf::Color color;
};

// Define all 7 Tetromino shapes
std::vector<Tetromino> createTetrominos() {
    std::vector<Tetromino> pieces;
    
    // I-piece (straight line)
    Tetromino i;
    i.shape = {
        {false, false, false, false},
        {true, true, true, true},
        {false, false, false, false},
        {false, false, false, false}
    };
    i.color = sf::Color::Cyan;
    pieces.push_back(i);
    
    // O-piece (square)
    Tetromino o;
    o.shape = {
        {true, true, false, false},
        {true, true, false, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    o.color = sf::Color::Yellow;
    pieces.push_back(o);
    
    // T-piece
    Tetromino t;
    t.shape = {
        {false, true, false, false},
        {true, true, true, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    t.color = sf::Color::Magenta;
    pieces.push_back(t);
    
    // S-piece
    Tetromino s;
    s.shape = {
        {false, true, true, false},
        {true, true, false, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    s.color = sf::Color::Green;
    pieces.push_back(s);
    
    // Z-piece
    Tetromino z;
    z.shape = {
        {true, true, false, false},
        {false, true, true, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    z.color = sf::Color::Red;
    pieces.push_back(z);
    
    // J-piece
    Tetromino j;
    j.shape = {
        {true, false, false, false},
        {true, true, true, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    j.color = sf::Color::Blue;
    pieces.push_back(j);
    
    // L-piece
    Tetromino l;
    l.shape = {
        {false, false, true, false},
        {true, true, true, false},
        {false, false, false, false},
        {false, false, false, false}
    };
    l.color = sf::Color(255, 165, 0); // Orange
    pieces.push_back(l);
    
    return pieces;
}

// Game class
class TetrisGame {
private:
    sf::RenderWindow window;
    std::vector<std::vector<sf::Color>> board;
    std::vector<Tetromino> pieces;
    Tetromino currentPiece;
    int currentX, currentY;
    int score;
    int level;
    int linesCleared;
    sf::Clock fallClock;
    sf::Clock inputClock;
    float fallSpeed;
    bool gameOver;
    
    // Initialize board with empty cells
    void initBoard() {
        board.clear();
        board.resize(BOARD_HEIGHT, std::vector<sf::Color>(BOARD_WIDTH, sf::Color::Black));
    }
    
    // Get a random piece
    Tetromino getRandomPiece() {
        return pieces[rand() % pieces.size()];
    }
    
    // Rotate piece 90 degrees clockwise
    Tetromino rotatePiece(const Tetromino& piece) {
        Tetromino rotated = piece;
        std::vector<std::vector<bool>> newShape(4, std::vector<bool>(4, false));
        
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                newShape[j][3 - i] = piece.shape[i][j];
            }
        }
        
        rotated.shape = newShape;
        return rotated;
    }
    
    // Check if piece can be placed at position
    bool isValidPosition(const Tetromino& piece, int x, int y) {
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                if (piece.shape[i][j]) {
                    int boardX = x + j;
                    int boardY = y + i;
                    
                    // Check boundaries
                    if (boardX < 0 || boardX >= BOARD_WIDTH || 
                        boardY >= BOARD_HEIGHT) {
                        return false;
                    }
                    
                    // Check collision with placed pieces
                    if (boardY >= 0 && board[boardY][boardX] != sf::Color::Black) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    
    // Place current piece on board
    void placePiece() {
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                if (currentPiece.shape[i][j]) {
                    int boardX = currentX + j;
                    int boardY = currentY + i;
                    if (boardY >= 0 && boardY < BOARD_HEIGHT && 
                        boardX >= 0 && boardX < BOARD_WIDTH) {
                        board[boardY][boardX] = currentPiece.color;
                    }
                }
            }
        }
        
        // Check for completed lines
        checkLines();
        
        // Spawn new piece
        spawnPiece();
    }
    
    // Check and clear completed lines
    void checkLines() {
        int cleared = 0;
        for (int y = 0; y < BOARD_HEIGHT; y++) {
            bool fullLine = true;
            for (int x = 0; x < BOARD_WIDTH; x++) {
                if (board[y][x] == sf::Color::Black) {
                    fullLine = false;
                    break;
                }
            }
            
            if (fullLine) {
                // Remove line and shift everything down
                for (int shiftY = y; shiftY > 0; shiftY--) {
                    for (int x = 0; x < BOARD_WIDTH; x++) {
                        board[shiftY][x] = board[shiftY - 1][x];
                    }
                }
                // Clear top line
                for (int x = 0; x < BOARD_WIDTH; x++) {
                    board[0][x] = sf::Color::Black;
                }
                cleared++;
            }
        }
        
        if (cleared > 0) {
            linesCleared += cleared;
            score += cleared * 100 * level;
            
            // Level up every 10 lines
            level = 1 + (linesCleared / 10);
            fallSpeed = std::max(0.05f, 0.5f - (level - 1) * 0.05f);
        }
    }
    
    // Spawn a new piece at top center
    void spawnPiece() {
        currentPiece = getRandomPiece();
        currentX = BOARD_WIDTH / 2 - 2;
        currentY = -1; // Start above the board
        
        // Check if game over
        if (!isValidPosition(currentPiece, currentX, currentY)) {
            gameOver = true;
        }
    }
    
    // Draw the game
    void draw() {
        window.clear(sf::Color::Black);
        
        // Draw board
        for (int y = 0; y < BOARD_HEIGHT; y++) {
            for (int x = 0; x < BOARD_WIDTH; x++) {
                sf::RectangleShape block(sf::Vector2f(BLOCK_SIZE - 1, BLOCK_SIZE - 1));
                block.setPosition(x * BLOCK_SIZE + 1, y * BLOCK_SIZE + 1);
                
                if (board[y][x] != sf::Color::Black) {
