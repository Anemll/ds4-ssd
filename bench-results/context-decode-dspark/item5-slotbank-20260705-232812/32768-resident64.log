private:
    // Game board: 0 = empty, 1-7 = piece type
    std::vector<std::vector<int>> board;
    
    // Current falling piece
    std::vector<std::vector<int>> currentPiece;
    int currentPieceType;
    int currentX, currentY;
    
    // Next piece
    std::vector<std::vector<int>> nextPiece;
    int nextPieceType;
    
    // Game state
    int score;
    int level;
    int linesCleared;
    bool gameOver;
    bool paused;
    
