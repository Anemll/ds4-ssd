using namespace std;

// Tetris game implementation
class Tetris {
private:
    // Game board dimensions
    static const int BOARD_WIDTH = 10;
    static const int BOARD_HEIGHT = 20;
    
    // Game board
    vector<vector<char>> board;
    
    // Current piece
    vector<vector<int>> currentPiece;
    int pieceX, pieceY;
    int pieceType;
    int rotation;
    
    // Game state
    int score;
    bool gameOver;
    
    // Tetromino shapes
    vector<vector<vector<int>>> pieces;
    
    // Colors for each piece type
    vector<string> pieceColors;
    
    // Current piece color
    string currentColor;
    
    // Timing
    int dropInterval;
    int lastDropTime;
    
    // Input handling
    char lastKey;
    
    // Score display
    int linesCleared;
    int level;
    
public:
    // Constructor
    TetrisGame() : score(0), gameOver(false), dropInterval(1000), lastKey(0), linesCleared(0), level(0) {
        // Initialize pieces
        pieces = {
            {{1, 1, 1, 1}}, // I piece
            {{1, 1}, {1, 1}}, // O piece
            {{0, 1, 0}, {1, 1, 1}}, // T piece
            {{1, 0, 0}, {1, 1, 1}}, // J piece
            {{0, 0, 1}, {1, 1, 1}}, // L piece
            {{1, 1, 0}, {0, 1, 1}}, // S piece
            {{0, 1, 1}, {1, 1, 0}}  // Z piece
        ];
        
        pieceColors = {"red", "green", "blue", "yellow", "purple", "cyan", "orange"};
        
        // Initialize board
        board = vector<vector<char>>(BOARD_HEIGHT, vector<char>(BOARD_WIDTH, ' '));
    }
    
    void draw() {
        background(0);
        if (gameOver) {
            // Draw game over screen
            fill(255, 0, 0);
            textSize(50);
            textAlign(CENTER, CENTER);
            text("GAME OVER", width/2, height/2);
            return;
        }
        
        // Draw the board
        for (int i = 0; i < BOARD_HEIGHT; i++) {
            for (int j = 0; j < BOARD_WIDTH; j++) {
                if (board[i][j] != 0) {
                    int colorIndex = board[i][j] - 1;
                    fill(colors[colorIndex][0], colors[colorIndex][1], colors[colorIndex][2]);
                    drawBlock(j, i);
                }
            }
        }
        
        // Draw the current piece
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                if (currentPiece[i][j] != 0) {
                    int colorIndex = currentPiece[i][j] - 1;
                    fill(colors[colorIndex][0], colors[colorIndex][1], colors[colorIndex][2]);
                    drawBlock(x + j, y + i);
                }
            }
        }
    }
    
    void drawBlock(int x, int y) {
        int blockX = x * BLOCK_SIZE + BOARD_X;
        int blockY = y * BLOCK_SIZE + BOARD_Y;
        rect(blockX, blockY, BLOCK_SIZE, BLOCK_SIZE);
    }
    
    void drawNextPiece() {
