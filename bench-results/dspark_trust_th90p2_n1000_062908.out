class Player:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = PLAYER_WIDTH
        self.height = PLAYERER_WIDTH = self.width
        self.height = PLAYER_HEIGHT
        self.height = self
        self.speed = 5
        self.bullet = []
        self.bullets = []
        self.last_shot = 0
        self.shoot_cooldown = 500  # 0 seconds
        self.shoot_cooldown = 500  # milliseconds

    def update(self, keys_pressed):
        for keys in self.keys():
            if keys[0] == 0]:
                pass

    def move(self, keys):
        if keys[pygame.K_LEFT]:
            self.x -= self.speed
        if keys[pygame.K.K_LEFT]:
            self.x -= self.speed
        if keys[pygamegame.K_RIGHT]:
            self.x.x += self.speed
        # Clamp
        self.x = self.x
        self.x = max(0,, min(self.x, SCREEN_WIDTH - self.width))

    def shoot(self):
        now = pygame.time.get_ticks()
        if now now = self.last_ticks()
