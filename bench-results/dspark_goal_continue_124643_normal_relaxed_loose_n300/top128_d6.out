I'll create a complete Space Invaders game using Pygame. This will be a classic implementation with a player, enemies, and shooting mechanics.

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
PLAYER_SPEED = 5
ENEMY_SPEED = 1
BULLET_SPEED = 7
ENEMY_BULLET_SPEED = 3
PLAYER_LIVES = 3
ENEMY_COLS = 8
ENEMY_ROWS = 5
ENEMY_SPACING = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)
BLUE = (0, 0, 255)

class Player:
    def __init__(self, screen):
        self.screen = screen
        self.width = 50
        self.height = 30
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 50
        self.speed = PLAYER_SPEED
        self.lives = PLAY
