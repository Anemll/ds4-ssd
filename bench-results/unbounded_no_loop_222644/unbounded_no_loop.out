I'll create a complete Space Invaders game using Pygame. This will be a classic implementation with all the essential features.

```python
import pygame
import random
import math

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)

class Game:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Invaders")
        self.clock = pygame.time.Clock()
        self.running = True
        self.font = pygame.font.Font(None, 36)
        self.small_font = pygame.font.Font(None, 24)
        
        # Player
        self.player = Player()
        
        # Create enemies
        self.enemies = []
        self.enemies_group = pygame.sprite.Group()
        self.create_enemies()
        
        # Bullets
        self.bullets = pygame.sprite.Group()
        self.enemy_bullets = pygame.sprite.Group()
        
        # Game state
        self.score = 0
        self.lives = 3
        self.game_over = False
        
        # Enemy movement
        self.enemy_direction = 1
        self.enemy_speed = 0.5
        self.enemy_drop = 0
        
        # Shooting
        self.enemy_shoot_timer = 0
        self.enemy_shoot_delay = 60  # frames
        
        # Explosion
        self.explosions = []
        
    def create_enemies(self):
        """Create enemy grid"""
        for row in range(5):
            for col in range(10):
                enemy = Enemy(col, row)
                self.enemies.append(enemy)
                self.enemies_group.add(enemy)
    
    def handle_events(self):
        """Handle game events"""
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE and not self.game_over:
                    self.player.shoot()
    
    def update(self):
        """Update game state"""
        if self.game_over:
            return
        
        # Update player
        self.player.update()
        
        # Update enemy bullets
        self.enemy_bullets.update()
        
        # Update player bullets
        self.bullets.update()
        
        # Move enemies
        self.move_enemies()
        
        # Enemy
