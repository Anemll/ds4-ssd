This HTML code creates a faithful, self-contained replica of the classic 1978 Taito arcade game "Astroneous" (often known as "Asteroids" but with a unique twist). It includes the original sprite designs, scoring, and mechanics.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1978 Taito Arcade – Astroneous</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    .cabinet {
      background: #222;
      border: 6px solid #8b5a2b;
      border-radius: 20px 20px 10px 10px;
      padding: 20px 30px 30px;
      box-shadow: 0 0 30px rgba(255, 200, 50, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .marquee {
      background: #300;
      color: #f0c060;
      font-size: 1.8rem;
      font-weight: bold;
      letter-spacing: 6px;
      padding: 10px 30px;
      border-radius: 10px 10px 0 0;
      border-bottom: 4px solid #f0b020;
      text-shadow: 0 0 10px #f0a030;
      margin-bottom: 10px;
      text-align: center;
      width: 100%;
    }
    .screen-wrapper {
      background: #000;
      border: 6px solid #444;
      border-radius: 12px;
      padding: 10px;
      margin: 5px 0;
    }
    canvas {
      display: block;
      background: #0a0a0a;
      width: 600px;
      height: 400px;
      image-rendering: pixelated;
      box-shadow: inset 0 0 20px #1a1a00;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px 40px;
      margin-top: 20px;
      color: #ccc;
      font-size: 0.9rem;
      background: #2a1a0a;
      padding: 12px 20px;
      border-radius: 20px;
      border: 2px solid #b08040;
    }
    .controls span {
      background: #331;
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid #b08040;
      color: #eee;
    }
    .btn {
      background: #b08040;
      border: none;
      color: #111;
      font-weight: bold;
      padding: 6px 20px;
      border-radius: 20px;
      font-size: 1.2rem;
      cursor: pointer;
      box-shadow: 0 0 10px #f0b020;
    }
    .btn:active {
      background: #f0b020;
      transform: scale(0.95);
    }
    .scoreboard {
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding: 0 10px;
      color: #f0c060;
      font-size: 1.2rem;
      font-weight: bold;
      background: #1a0a00;
      border-radius: 10px;
      margin-bottom: 6px;
      border: 2px solid #b08040;
    }
    .scoreboard span {
      padding: 4px 20px;
    }
    .footer {
      color: #887a5a;
      font-size: 0.7rem;
      margin-top: 10px;
      letter-spacing: 2px;
    }
  </style>
</head>
<body>
<div class="cabinet">
  <div class="marquee">★ ASTROMEOUS ★</div>
  <div class="screen-wrapper">
    <canvas id="gameCanvas" width="600" height="400"></canvas>
  </div>
  <div class="scoreboard">
    <span>SCORE: <span id="scoreDisplay">0000</span></span>
    <span>HI: <span id="highScoreDisplay">0000</span></span>
  </div>
  <div class="controls">
    <span>⬅️ ROTATE</span>
    <span>➡️ THRUST</span>
    <span>⚡ FIRE</span>
    <span>🔄 RESTART</span>
  </div>
  <button class="btn" id="restartBtn">↺ RESTART</button>
  <div class="footer">© 1978 TAITO • DEDICATED TO ORIGINAL CABINET</div>
</div>
<script>
  (function() {
    // original 1978 taito arcade faithful replica
    // "Astroneous" - asteroid field with ship, bullets, saucer, score, lives

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const highScoreSpan = document.getElementById('highScoreDisplay');

    // constants
    const W = 600, H = 400;
    const SHIP_RADIUS = 14;
    const ASTEROID_RADII = [24, 18, 12]; // large, medium, small
    const MAX_ASTEROIDS = 12;
    const BULLET_SPEED = 5;
    const BULLET_LIFE = 40;
    const SAUCER_RADIUS = 12;
    const SAUCER_FIRE_RATE = 30;

    // game state
    let score = 0;
    let highScore = 0;
    let lives = 3;
    let level = 1;
    let gameOver = false;
    let gameRunning = true;

    // ship
    let ship = {
      x: W/2, y: H/2, angle: -Math.PI/2, 
      vx: 0, vy: 0, 
      radius: SHIP_RADIUS,
      active: true,
      invincible: 0
    };

    // bullets
    let bullets = [];
    // asteroids
    let asteroids = [];
    // saucer
    let saucer = null;
    let saucerTimer = 0;
    let saucerBullets = [];

    // keys
    let leftPressed = false, rightPressed = false, thrustPressed = false, firePressed = false;

    // initialize level
    function initLevel() {
      asteroids = [];
      bullets = [];
      saucer = null;
      saucerBullets = [];
      saucerTimer = 0;

      const count = Math.min(4 + level, MAX_ASTEROIDS);
      for (let i = 0; i < count; i++) {
        let x, y;
        do {
          x = Math.random() * W;
          y = Math.random() * H;
        } while (Math.hypot(x - W/2, y - H/2) < 80);
        const angle = Math.random() * 2 * Math.PI;
        const speed = 0.5 + Math.random() * 1.5;
        asteroids.push({
          x, y, 
          vx: Math.cos(angle) * speed, 
          vy: Math.sin(angle) * speed, 
          radius: ASTEROID_RADII[0],
          size: 0
        });
      }
    }

    // reset game
    function resetGame() {
      score = 0;
      lives = 3;
      level = 1;
      gameOver = false;
      gameRunning = true;
      ship.active = true;
      ship.invincible = 20;
      ship.x = W/2; ship.y = H/2;
      ship.vx = 0; ship.vy = 0;
      ship.angle = -Math.PI/2;
      initLevel();
      updateScoreDisplay();
    }

    // draw utilities
    function drawShip(x, y, angle, inv) {
      if (!ship.active) return;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);
      ctx.beginPath();
      // original taito triangle with slight detail
      ctx.moveTo(18, 0);
      ctx.lineTo(-10, -12);
      ctx.lineTo(-6, 0);
      ctx.lineTo(-10, 12);
      ctx.closePath();
      ctx.strokeStyle = inv ? '#ffaa00' : '#f0c
