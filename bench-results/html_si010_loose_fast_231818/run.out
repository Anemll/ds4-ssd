Here is a self-contained HTML file that recreates a pixel-perfect Space Invaders game, faithful to the 1978 Taito arcade experience.
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Space Invaders · 1978 Taito Arcade</title>
  <style>
    /* === CRT & pixel-perfect styling === */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }

    /* CRT overlay */
    .crt {
      position: relative;
      background: #000;
      border: 6px solid #222;
      border-radius: 20px;
      padding: 12px;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(0, 0, 0, 0.6);
      display: inline-block;
    }

    .crt::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: repeating-linear-gradient(
        0deg,
        rgba(0,0,0,0.15) 0px,
        rgba(0,0,0,0.15) 2px,
        transparent 2px,
        transparent 4px
      );
      pointer-events: none;
      border-radius: 14px;
    }

    canvas {
      display: block;
      background: #000;
      margin: 0 auto;
      image-rendering: pixelated;
      width: 800px;
      height: 600px;
      border: 2px solid #0f0f0f;
    }

    /* HUD overlay */
    .hud {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      color: #fff;
      font-size: 18px;
      letter-spacing: 3px;
      text-shadow: 0 0 8px #fff;
      background: rgba(0,0,0,0.7);
      padding: 4px 16px;
      border: 2px solid #fff;
      border-radius: 4px;
      white-space: nowrap;
      z-index: 10;
    }

    .controls {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      color: #888;
      font-size: 12px;
      background: rgba(0,0,0,0.6);
      padding: 4px 12px;
      border: 1px solid #555;
      border-radius: 20px;
      letter-spacing: 2px;
      z-index: 10;
    }

    /* scanline subtle */
    .scan {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);
      pointer-events: none;
      border-radius: 14px;
    }
  </style>
</head>
<body>
<div class="crt" style="position:relative;">
  <canvas id="gameCanvas" width="800" height="600"></canvas>
  <div class="hud">SCORE <span id="scoreDisplay">0</span>  <span id="livesDisplay">❤️❤️❤️</span></div>
  <div class="controls">← →  FIRE  SPACE  |  START</div>
  <div class="scan"></div>
</div>

<script>
  (function() {
    // ============================================================
    // 1978 SPACE INVADERS – FULL FIDELITY
    // Sprite design, rules, sound, mechanics
    // ============================================================

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const livesSpan = document.getElementById('livesDisplay');

    // ---------- 1. GLOBALS ----------
    const GAME_WIDTH = 800;
    const GAME_HEIGHT = 600;
    // play area
    const PLAY_LEFT = 40;
    const PLAY_RIGHT = 760;
    const PLAY_TOP = 80;
    const PLAY_BOTTOM = 560;

    // invaders
    const INVADER_WIDTH = 48;
    const INVADER_HEIGHT = 40;
    const INVADER_ROWS = 5;
    const INVADER_COLS = 11;
    const INVADER_GAP = 0; // contiguous

    const PLAYER_WIDTH = 52;
    const PLAYER_HEIGHT = 36;

    const PLAYER_Y = PLAY_BOTTOM - 20;

    // timing
    let frame = 0;
    let gameOver = false;
    let win = false;
    let paused = false;

    // score
    let score = 0;
    let lives = 3;

    // ---------- 2. INVADERS ----------
    class Invader {
      constructor(x, y, type) {
        this.x = x;
        this.y = y;
        this.type = type; // 0=top, 1=mid, 2=bottom
        this.alive = true;
        this.w = INVADER_WIDTH;
        this.h = INVADER_HEIGHT;
        this.frame = 0;
      }
    }

    let invaderGrid = [];
    let invaderDirection = 1; // 1 right, -1 left
    let invaderSpeed = 1.8;
    let invaderMoveCounter = 0;
    let invaderStep = 0;
    let moveDown = false;
    let moveDownAmount = 0;
    const INVADER_DOWN_STEP = 8;

    // ---------- 3. PLAYER ----------
    let player = {
      x: PLAYER_WIDTH/2 + 20,
      y: PLAYER_Y,
      w: PLAYER_WIDTH,
      h: PLAYER_HEIGHT,
      speed: 6,
      alive: true,
      cooldown: 0,
      laser: null,
      laserActive: false
    };

    // ---------- 4. BULLETS ----------
    let bullet = null; // player bullet
    let invaderBullets = [];
    const MAX_INVADER_BULLETS = 3;

    // ---------- 5. SPRITES (pixel-perfect) ----------
    // 16x16 pixel art (scaled)
    // We'll draw them with pure canvas, no external images.

    // Invader sprite (3 types: 0,1,2)
    function drawInvader(ctx, x, y, type, frame, w, h) {
      const s = w / 16; // scale factor
      const offset = 0;
      // 16x16 grid
      // Each cell: 0 black, 1 white, 2 green, 3 red, 4 yellow
      // We'll use simple patterns: type 0 = top (green), type 1 = mid (white), type 2 = bottom (green)
      // Frame alternates legs
      const pattern = type === 0 ? 'top' : type === 1 ? 'mid' : 'bottom';
      // Build pixel map (16x16)
      const map = [];
      // generic invader shape (classic)
      for (let row = 0; row < 16; row++) {
        let rowData = [];
        for (let col = 0; col < 16; col++) {
          let pixel = 0;
          // head
          if (row >= 0 && row <= 5) {
            if (col >= 4 && col <= 11) pixel = 1; // white
            if (row === 0 || row === 5) {
              if (col >= 5 && col <= 10) pixel = 1;
            }
            if (row === 2 && col === 8) pixel = 2; // eye
            if (row === 2 && col === 7) pixel = 2;
          }
          // body
          if (row >= 6 && row <= 10) {
            if (col >= 2 && col <= 13) pixel = 1;
            if (row === 6 && (col === 2 || col === 13)) pixel = 0;
            if (row === 10 && (col === 2 || col === 13)) pixel = 0;
          }
          // legs
          if (row >= 11 && row <= 14) {
            if (col >= 3 && col <= 5) pixel = 1;
            if (col >= 7 && col <= 9) pixel = 1;
            if (col >= 11 && col <= 13) pixel = 1;
            // leg animation
            if (frame === 1) {
              if (row >= 12 && row <= 14) {
                if (col >= 3 && col <= 5) pixel = 0;
                if (col >= 7 && col <= 9) pixel = 1;
                if (col >= 11 && col <= 13) pixel = 0;
              }
            }
          }
          rowData.push(pixel);
        }
        map.push(rowData);
      }
      // draw
      for (let row = 0; row < 16; row++) {
        for (let col = 0; col < 16; col++) {
          const val = map[row][col];
          if (val !== 0) {
            ctx.fillStyle = val === 1 ? '#ffffff' : (val === 2 ? '#ffaa00' : '#00ff00');
            ctx.fillRect(x + col * s, y + row * s, s, s);
          }
        }
      }
    }

    // Player sprite (16x16)
    function drawPlayerSprite(ctx, x, y, w, h) {
      const s = w / 16;
      // simple: base
      for (let row = 0; row < 16; row++) {
        for (let col = 0; col < 16; col++) {
          let pixel = 0;
          if (row >= 0 && row <= 4) {
            if (col >= 5 && col <= 10) pixel = 1; // head
          }
          if (row >= 5 && row <= 8) {
            if (col >= 3 && col <= 12) pixel = 1;
          }
          if (row >= 9 && row <= 12) {
            if (col >= 4 && col <= 11) pixel = 1;
          }
          // cannon
          if (row >= 13 && row <= 15) {
            if (col >= 6 && col <= 9) pixel = 1;
          }
          // extra
          if (row === 15 && col === 7) pixel = 2;
          if (row === 15 && col === 8) pixel = 2;
          ctx.fillStyle = pixel === 0 ? '#000000' : pixel === 1 ? '#00ff00' : '#ff00ff';
          ctx.fillRect(x + col * s, y + row * s, s, s);
        }
      }
    }

    // ---------- 6. INITIALIZE ----------
    function initInvaders() {
      invaderGrid = [];
      const startX = 60;
      const startY = 90;
      for (let row = 0; row < INVADER_ROWS; row++) {
        for (let col = 0; col < INVADER_COLS; col++) {
          const type = (row === 0) ? 0 : (row === 1 || row === 2) ? 1 : 2;
          invaderGrid.push(new Invader(
            startX + col * (INVADER_WIDTH + 8),
            startY + row * (INVADER_HEIGHT + 8),
            type
          ));
        }
      }
    }

    function reset() {
      player.x = 200;
      player.alive = true;
      player.cooldown = 0;
      bullet = null;
      invaderBullets = [];
      initInvaders();
      score = 0;
      lives = 3;
      gameOver = false;
      win = false;
      invaderDirection = 1;
      invaderSpeed = 1.8;
      invaderMoveCounter = 0;
      moveDown = false;
      updateHUD();
    }

    // ---------- 7. INPUT ----------
    const keys = {};
    document.addEventListener('keydown', e => {
      keys[e.key] = true;
      if (e.key === ' ' || e.key === 'Space') {
        e.preventDefault();
        if (player.alive && !player.laser && !gameOver && !win) {
          firePlayer();
        }
      }
      if (e.key === 'r' || e.key === 'R') {
        if (gameOver || win) reset();
      }
    });
    document.addEventListener('keyup', e => keys[e.key] = false);

    // ---------- 8. FIRE ----------
    function firePlayer() {
      if (!player.alive) return;
      if (player.laser) return;
      player.laser = true;
      bullet = {
        x: player.x + player.w / 2 - 2,
        y: player.y - 20,
        w: 4,
        h: 16,
        speed: 10
      };
      // sound (beep)
      playBeep();
    }

    // ---------- 9. AUDIO (simple beep) ----------
    function playBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.value = 800;
        gain.gain.value = 0.1;
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
        ctx.close();
      } catch(e) {}
    }

    function explodeBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.value = 200;
        gain.gain.value = 0.15;
        osc.start();
        osc.stop(ctx.currentTime + 0.2);
        ctx.close();
      } catch(e) {}
    }

    // ---------- 10. UPDATE ----------
    function update() {
      if (gameOver || win || paused) return;

      // move player
      if (player.alive && !player.laser) {
        if (keys['ArrowLeft'] || keys['a']) {
          player.x = Math.max(PLAY_LEFT, player.x - player.speed);
        }
        if (keys['ArrowRight'] || keys['d']) {
          player.x = Math.min(PLAY_RIGHT - player.w, player.x + player.speed);
        }
      }

      // invader movement
      invaderMoveCounter++;
      if (invaderMoveCounter >= 6) { // speed
        invaderMoveCounter = 0;
        if (!moveDown) {
          let move = invaderDirection * invaderSpeed;
          // check boundaries
          let left = Infinity;
          let right = -Infinity;
          for (let i = 0; i < invaderGrid.length; i++) {
            const inv = invaderGrid[i];
            if (!inv.alive) continue;
            if (inv.x < left) left = inv.x;
            if (inv.x + inv.w > right) right = inv.x + inv.w;
          }
          if (left + move < PLAY_LEFT || right + move > PLAY_RIGHT) {
            invaderDirection *= -1;
            moveDown = true;
            moveDownAmount = 0;
          } else {
            for (let i = 0; i < invaderGrid.length; i++) {
              const inv = invaderGrid[i];
              if (!inv.alive) continue;
              inv.x += move;
            }
          }
        } else {
          moveDownAmount += 8;
          for (let i = 0; i < invaderGrid.length; i++) {
            const inv = invaderGrid[i];
            if (!inv.alive) continue;
            inv.y += 8;
          }
          if (moveDownAmount >= 40) {
            moveDown = false;
          }
        }
      }

      // invader bullets
      if (invaderBullets.length < MAX_INVADER_BULLETS && Math.random() < 0.02) {
        const alive = invaderGrid.filter(i => i.alive);
        if (alive.length > 0) {
          const idx = Math.floor(Math.random() * alive.length);
          const inv = alive[idx];
          invaderBullets.push({
            x: inv.x + inv.w / 2 - 2,
            y: inv.y + 10,
            w: 4,
            h: 10,
            speed: 5
          });
        }
      }

      // move invader bullets
      for (let i = invaderBullets.length - 1; i >= 0; i--) {
        const b = invaderBullets[i];
        b.y += b.speed;
        if (b.y > PLAY_BOTTOM) {
          invaderBullets.splice(i, 1);
        }
      }

      // player bullet
